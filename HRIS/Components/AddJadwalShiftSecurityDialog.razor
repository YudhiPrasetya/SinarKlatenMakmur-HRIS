@using HRIS.Contracts;
@using SKM.Shared.Dtos;
@inject ISnackbar Snackbar;

<MudDialog>
   <DialogContent>
      <MudForm @ref="frmJadwalShiftSecurity">
         <MudTextField @ref="Deskripsi" T="string" Label="Deskripsi" Variant="Variant.Outlined" @bind-Value="jadwalShiftSecurityDTO.Deskripsi"></MudTextField>
         <MudTimePicker @ref="jadwalMasuk" Label="Jadwal Masuk" Variant="Variant.Outlined" PickerVariant="PickerVariant.Dialog" @bind-Time="jadwalShiftSecurityDTO.JadwalMasuk"></MudTimePicker>
         <MudTimePicker @ref="jadwalPulang" Variant="Variant.Outlined" PickerVariant="PickerVariant.Dialog" @bind-Time="jadwalShiftSecurityDTO.JadwalPulang" Label="Jadwal Pulang"></MudTimePicker>
         <MudTextField @ref="inisial" Variant="Variant.Outlined" @bind-Value="jadwalShiftSecurityDTO.Initial" Label="Inisial"></MudTextField>
      </MudForm>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="Close">Close</MudButton>
      <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
   </DialogActions>
</MudDialog>

@code {
   [CascadingParameter] MudDialogInstance MudDialog { get; set; }

   [Inject]IJadwalShiftSecurityServicecs jadwalShiftSecurityService { get; set; }
   MudForm frmJadwalShiftSecurity;
   JadwalShiftSecurityDTO jadwalShiftSecurityDTO { get; set; } = new();
   MudTextField<string> Deskripsi;
   MudTimePicker jadwalMasuk;
   MudTimePicker jadwalPulang;
   MudTextField<string?> inisial;

   async Task Submit() {
      JadwalShiftSecurityDTO jssDTO = new()
         {
            Id = 0,
            Deskripsi = jadwalShiftSecurityDTO.Deskripsi,
            JadwalMasuk = jadwalShiftSecurityDTO.JadwalMasuk,
            JadwalPulang = jadwalShiftSecurityDTO.JadwalPulang,
            Initial = jadwalShiftSecurityDTO.Initial
         };
      var jadwal = await jadwalShiftSecurityService.AddJadwalShiftSecurity(jssDTO);
      if(jadwal != null) {
         Snackbar.Add("Data Jadwal Shift Security berhasil ditambahkan.", Severity.Success, c =>
         {
            c.HideTransitionDuration = 300;
         });         
      }
      await frmJadwalShiftSecurity.ResetAsync();
      
   }

   void Close() {
      MudDialog?.Close(DialogResult.Ok(true));
   } 
}
