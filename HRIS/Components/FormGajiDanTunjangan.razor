@using HRIS.Contracts
@using HRIS.Pages.SharedModal
@using HRIS.Services
@using SKM.Shared.Dtos
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudCard Class="my-4">
   @if (!dataLoaded) {
      <MudCardHeader>
         <CardHeaderContent>
            <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Height="37px" Width="100px" />
         </CardHeaderContent>
         <CardHeaderActions>
            <MudSkeleton SkeletonType="SkeletonType.Circle" Animation="Animation.Pulse" Height="40px" Width="40px" />
         </CardHeaderActions>
      </MudCardHeader>
      <MudCardContent>
         <MudGrid>
            <MudItem>
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm="3">
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm=3>
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm=3>
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm="3">
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm="3">
               <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" />
            </MudItem>
         </MudGrid>
         <MudGrid>
            <MudItem sm="6">
               <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm="6">
               <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
            </MudItem>
         </MudGrid>

         <MudGrid>
            <MudItem sm="6">
               <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
            </MudItem>
            <MudItem sm="6">
               <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
            </MudItem>
         </MudGrid>
         <MudGrid>
            <MudItem sm="12">
               <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
            </MudItem>
         </MudGrid>
      </MudCardContent>
      <MudCardActions>
         <MudStack Row="true">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" Width="100px" Height="35px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" Width="100px" Height="35px" />
         </MudStack>
      </MudCardActions>
   }else{
   <MudCardHeader>
      <CardHeaderContent>
         <MudText Typo="Typo.h6">Tambah Data Gaji Satu Persatu</MudText>
      </CardHeaderContent>
      <CardHeaderActions>
         <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
      </CardHeaderActions>
   </MudCardHeader>
   <MudCardContent>
      <MudForm @ref="gajiSatuForm">
         <MudGrid>
            <MudItem>
               <MudTextField @bind-Value="@gajiDTO.Id" @ref="Id" Label="Id" Disabled="true"></MudTextField>
            </MudItem>
            <MudItem sm="3">
               <MudTextField @ref="NIK" @bind-Value="@gajiDTO.NIK" Class="pa-0" T="string" Label="NIK" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="CariKaryawan"></MudTextField>
            </MudItem>
            <MudItem sm=3>
               <MudTextField @ref="@namaKaryawan" T="string" Label="Nama Karyawan" @bind-Value="gajiDTO.NamaKaryawan" Disabled="true"></MudTextField>
            </MudItem>
            <MudItem sm=3>
               <MudTextField @ref="grupKerja" T="string" Disabled="true" Label="Grup Kerja" @bind-Value="@gajiDTO.GrupKerja"></MudTextField>
            </MudItem>
            <MudItem sm="3">
               <MudSelect @ref="UMP" T="decimal" Label="UMP..." Class="pa-1" @bind-Value="@gajiDTO.Upah">
                  @foreach(var umpDTO in umpDTOs) {
                     <MudSelectItem Value="@umpDTO.Jumlah">@umpDTO.Keterangan</MudSelectItem>
                  }
               </MudSelect>
            </MudItem>
            <MudItem sm="3">
               <MudSelect Placeholder="PTKP" T="string" @ref="PTKP" Label="PTKP..." @bind-Text="@gajiDTO.PTKP">
                  @foreach(var ptkpDTO in ptkpDTOs){
                     <MudSelectItem Value="@ptkpDTO.ToString()">@ptkpDTO.Keterangan</MudSelectItem>
                  }
               </MudSelect>
            </MudItem>
         </MudGrid>
         <MudGrid>
            <MudItem sm="6">
               <MudField Label="Tunjangan" Variant="Variant.Outlined">
                  <MudNumericField @ref="TunjJabatan" @bind-Value="gajiDTO.TunjJabatan" Label="Jabatan" T="int?"></MudNumericField>
                  <MudNumericField @ref="TunjKeterampilan" @bind-Value="gajiDTO.TunjKeterampilan" Label="Keterampilan" T="int?"></MudNumericField>
                  <MudNumericField @ref="TunjLain" @bind-Value="gajiDTO.TunjLain" Label="DLL" T="int?"></MudNumericField>
               </MudField>
            </MudItem>
            <MudItem sm="6">
               <MudField Label="Potongan" Variant="Variant.Outlined">
                  <MudNumericField @ref="PotonganKoperasi" @bind-Value="gajiDTO.PotonganKoperasi" Label="Koperasi" T="int?"></MudNumericField>
                  <MudNumericField @ref="PotonganLain" @bind-Value="gajiDTO.PotonganLain" Label="DLL" T="int?"></MudNumericField>
               </MudField>
            </MudItem>
         </MudGrid>

         <MudGrid>
            <MudItem sm="6">
               <MudField Label="BPJS Tenaga Kerja" Variant="Variant.Outlined">
                  <MudRadioGroup @bind-SelectedOption="gajiDTO.Potong_BPJSTK" @ref="BPJSTK">
                     <MudRadio Option="@("Potong")">Potong</MudRadio>
                     <MudRadio Option="@("Tidak")">Tidak</MudRadio>
                  </MudRadioGroup>
               </MudField>
            </MudItem>
            <MudItem sm="6">
               <MudField Label="BPJS Kesehatan" Variant="Variant.Outlined">
                  <MudRadioGroup @bind-SelectedOption="gajiDTO.Potong_BPJSKes" @ref="BPJSKes">
                     <MudRadio Option="@("Potong")">Potong</MudRadio>
                     <MudRadio Option="@("Tidak")">Tidak</MudRadio>
                  </MudRadioGroup>
               </MudField>
            </MudItem>
         </MudGrid>
         <MudGrid>
            <MudItem sm="12">
               <MudField Variant="Variant.Outlined" Label="BPJS Kesehatan Orang Tua">
                  <MudGrid>
                     <MudItem sm="6">
                        <MudTextField Label="Orang Tua 1(%)" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu1" @ref="BPJSOrtu1" Format="F2"></MudTextField>
                        <MudTextField Label="Orang Tua 2(%)" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu2" @ref="BPJSOrtu2" Format="F2"></MudTextField>
                     </MudItem>
                     <MudItem sm="6">
                        <MudTextField Label="Orang Tua 3(%)" @ref="BPJSOrtu3" T="decimal?" @bind-Value=gajiDTO.BPJS_Ortu3 Format="F2"></MudTextField>
                        <MudTextField Label="Orang Tua 4(%)" @ref="BPJSOrtu4" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu4" Format="F2"></MudTextField>
                     </MudItem>
                  </MudGrid>
               </MudField>
            </MudItem>
         </MudGrid>
      </MudForm>
   </MudCardContent>
   <MudCardActions>
      <MudStack Row="true">
         <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Filled" Color="Color.Success" OnClick="SaveGaji">Save</MudButton>
         <MudButton StartIcon="@Icons.Material.Filled.Cancel" Variant="Variant.Filled" Color="Color.Warning" OnClick="CancelGaji">Cancel</MudButton>
      </MudStack>
   </MudCardActions>
   }
</MudCard>

@code {
   [Parameter]public string ModalLabel { get; set; }
   [Parameter]public GajiDanTunjanganDTO gajiDTO { get; set; } = new GajiDanTunjanganDTO();
   [Parameter]public IEnumerable<EmployeeDTO> EmployeeDTOS { get; set; } = new List<EmployeeDTO>();

   public bool IsShow { get; set; } = false;
   private MudForm gajiSatuForm;
   private MudTextField<int> Id;
   private MudTextField<string> NIK;
   private MudTextField<string> grupKerja;
   private MudTextField<string> namaKaryawan;
   private MudSelect<decimal> UMP;
   private MudSelect<string> PTKP;
   private string selectedBPJSKes { get; set; }
   private string selectedBPJSTK { get; set; }
   private MudTextField<decimal?> BPJSOrtu1 { get; set; }
   private MudTextField<decimal?> BPJSOrtu2 { get; set; }
   private MudTextField<decimal?> BPJSOrtu3 { get; set; }
   private MudTextField<decimal?> BPJSOrtu4 { get; set; }
   private MudNumericField<int?> TunjJabatan { get; set; }
   private MudNumericField<int?> TunjKeterampilan { get; set; }
   private MudNumericField<int?> TunjLain { get; set; }
   private MudNumericField<int?> PotonganKoperasi { get; set; }
   private MudNumericField<int?> PotonganLain { get; set; }
   private MudRadioGroup<string?> BPJSTK { get; set; }
   private MudRadioGroup<string?> BPJSKes { get; set; }

   private UpahMinimumProvinsiDTO selectedUMP { get; set; }
   // private string Mode = "Add";

   [Parameter]
   public GajiDanTunjanganDTO newGajiDTO { get; set; }

   [Parameter]
   public GajiDanTunjanganDTO editGajiDTO { get; set; }

   [Parameter]
   public EventCallback<GajiDanTunjanganDTO> OnGajiAdded { get; set; }

   [Parameter]
   public EventCallback<GajiDanTunjanganDTO> OnGajiUpdate { get; set; }

   [Parameter]
   public EventCallback<GajiDanTunjanganDTO> GajiEdit { get; set; }

   private bool dataLoaded = false;
   private bool overlayVisible;
   [Inject] IEmployeeService empService { get; set; }
   [Inject] IPTKPService ptkpService { get; set; }
   [Inject] IUMPService umpService { get; set; }

   private IEnumerable<EmployeeDTO> empDTOs { get; set; } = new List<EmployeeDTO>();
   private IEnumerable<UpahMinimumProvinsiDTO> umpDTOs { get; set; } = new List<UpahMinimumProvinsiDTO>();
   private IEnumerable<PenghasilanTidakKenaPajakDTO> ptkpDTOs { get; set; } = new List<PenghasilanTidakKenaPajakDTO>();

   protected override async Task OnInitializedAsync() {
      // return base.OnInitializedAsync();
      await Task.Delay(50);
      dataLoaded = false;
      overlayVisible = true;
      empDTOs = await empService.GetListEmployeesAsync();
      ptkpDTOs = await ptkpService.GetPTKPAsync();
      umpDTOs = await umpService.GetUMP();

      dataLoaded = true;
      overlayVisible = false;
      StateHasChanged();
   }

   async Task CariKaryawan() {
      var parameters = new DialogParameters<SearchEmployeeModal>();
      parameters.Add("ModalLabel", "Cari Data Karyawan");
      parameters.Add("EmployeeDTOS", empDTOs);
      //parameters.Add("GroupDTOS", Groups);
      var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };
      var dialog = await DialogService.ShowAsync<SearchEmployeeModal>("Data Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         EmployeeDTO empDTO = new EmployeeDTO();
         empDTO = result.Data as EmployeeDTO;

         gajiDTO.GrupKerja = empDTO.GroupName;
         gajiDTO.NIK = empDTO.NIK;
         gajiDTO.NamaKaryawan = empDTO.Name;
         gajiDTO.GrupKerja = empDTO.GroupName;
         //IdEmployee.Value = empDTO.EmployeeId;
         //NIK.Value = empDTO.NIK;
         //Nama.Value = empDTO.Name;
      }
   }

   private async void SaveGaji() {
      string[] arrPTKP = PTKP.Text.Split("-");
      newGajiDTO = new GajiDanTunjanganDTO()
      {
         Id = Id.Value,
         GrupKerja = grupKerja.Value,
         NIK = NIK.Value,
         NamaKaryawan = namaKaryawan.Value,
         Upah = UMP.Value,
         PTKP = arrPTKP[0],
         PTKP_Jumlah = int.Parse(arrPTKP[1]),
         TunjJabatan = TunjJabatan.Value,
         TunjKeterampilan = TunjKeterampilan.Value,
         TunjMasaKerja = 0,
         TunjLain = TunjLain.Value,
         PotonganKoperasi = PotonganKoperasi.Value,
         PotonganLain = PotonganLain.Value,
         Potong_BPJSKes = BPJSKes.SelectedOption,
         Potong_BPJSTK = BPJSTK.SelectedOption,
         BPJS_Ortu1 = BPJSOrtu1.Value,
         BPJS_Ortu2 = BPJSOrtu2.Value,
         BPJS_Ortu3 = BPJSOrtu3.Value,
         BPJS_Ortu4 = BPJSOrtu4.Value,
         CreatedBy = 1,
         CreatedAt = DateTime.Now,
         UpdatedBy = 1,
         UpdatedAt = DateTime.Now
      };

      if(Id.Value == 0) {
         await OnGajiAdded.InvokeAsync(newGajiDTO);
      }else{
         await OnGajiUpdate.InvokeAsync(gajiDTO);
      }
      await gajiSatuForm.ResetAsync();
      Snackbar.Add($"Data Gaji dan Tunjangan berhasil diupdate di database.", Severity.Success, config => {
         config.HideTransitionDuration = 100;
      });
   }

   private void CancelGaji() {
      gajiSatuForm.ResetAsync();

   }
}
