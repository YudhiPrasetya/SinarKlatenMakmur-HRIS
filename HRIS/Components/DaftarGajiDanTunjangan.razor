	private async Task<TableData<GajiDanTunjanganDTO>> ServerReload(TableState state) {
		// IEnumerable<GajiDanTunjanganDTO> data = await gajiService.GetGajiListAsync();
		await Task.Delay(300);
		gajiDTOs = gajiDTOs.Where(el => {
			if (string.IsNullOrWhiteSpace(searchString)) return true;
			if (el.Id.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.GrupKerja.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.NamaKaryawan.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.Upah.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.PTKP.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.PTKP_Jumlah.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.TunjJabatan.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.TunjKeterampilan.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.TunjMasaKerja.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.TunjLain.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.PotonganKoperasi.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.PotonganLain.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.Potong_BPJSKes.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.Potong_BPJSTK.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.BPJS_Ortu1.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.BPJS_Ortu2.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.BPJS_Ortu3.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.BPJS_Ortu4.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if ($"{el.Id.ToString()}{el.GrupKerja}{el.NIK}{el.NamaKaryawan}{el.Upah.ToString()}{el.PTKP}{el.PTKP_Jumlah}{el.TunjJabatan.ToString()}{el.TunjKeterampilan.ToString()}{el.TunjMasaKerja.ToString()}{el.TunjLain.ToString()}{el.PotonganKoperasi.ToString()}{el.PotonganLain.ToString()}{el.Potong_BPJSKes}{el.Potong_BPJSTK}{el.BPJS_Ortu1.ToString()}{el.BPJS_Ortu2.ToString()}{el.BPJS_Ortu3.ToString()}{el.BPJS_Ortu4.ToString()}".Contains(searchString)) return true;
			return false;
		}).ToArray();
		totalItems = gajiDTOs.Count();
		switch (state.SortLabel) {
			case "id_field":
			gajiDTOs = gajiDTOs.OrderByDirection(state.SortDirection, o => o.Id);
			break;
			case "group_field":
			gajiDTOs = gajiDTOs.OrderByDirection(state.SortDirection, o => o.GrupKerja);
			break;
			case "nik_field":
			gajiDTOs = gajiDTOs.OrderByDirection(state.SortDirection, o => o.NIK);
			break;			
			case "namaKaryawan_field":
			gajiDTOs = gajiDTOs.OrderByDirection(state.SortDirection, o => o.NamaKaryawan);
			break;

		}

		pagedData = gajiDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
		return new TableData<GajiDanTunjanganDTO>() { TotalItems = totalItems, Items = pagedData };
	}

	private void OnSearch(string text) {
		searchString = text;
		gajiTable.ReloadServerData();
	}

	async Task EditGajiDanTunjangan(GajiDanTunjanganDTO gaji) {
		Mode = "Edit";
		await GetGaji.InvokeAsync(gaji);
	}

	async Task HapusGajiDanTunjangan(int Id) {
		await DeleteGaji.InvokeAsync(Id);

	}
