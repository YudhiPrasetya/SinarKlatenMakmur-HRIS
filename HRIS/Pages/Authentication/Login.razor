@inherits LayoutComponentBase

@page "/login1"
@attribute [AllowAnonymous]

@using HRIS.Models
@using HRIS.Contracts

@layout AuthLayout
@inject NavigationManager navigationManager
@inject IAuthenticationHttpClientService authenticationHttpClientService

<MudGrid>
   <MudItem xs="6">
      <MudCard Width="500px">
         <MudCardHeader>
            <MudChip Color="Color.Primary">
               <MudText Align="Align.Center" Typo="Typo.h3"><strong>Login Form</strong></MudText>
            </MudChip>
         </MudCardHeader>
         <MudForm @ref="form">
            <MudCardContent>
               <MudTextField @bind-Value="user.UserName"
                             Immediate="true"
                             Label="User Name" />
               <MudTextField @bind-Value="user.Password"
                             Immediate="true"
                             Label="Password" InputType="InputType.Password" />
               <MudCardActions>
                  <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="LoginAsync">Login</MudButton>
               </MudCardActions>
            </MudCardContent>
         </MudForm>
      </MudCard>
   </MudItem>
</MudGrid>


@code {
   UserLoginDTO user { get; set; } = new();
   MudTextField<string> UserName;
   MudTextField<string> Psw;
   MudForm form;

   private async Task LoginAsync() {
      try {
         var result = await authenticationHttpClientService.LoginUser(user);
         // if (result.Succeeded) {
         if (result != null) {
            navigationManager.NavigateTo("");

         }
         else {
            
         }
      }
		catch (System.Exception) {
			
			throw;
		}
	}
}
