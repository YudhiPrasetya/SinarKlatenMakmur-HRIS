@page "/lapKaryawanTidakHadir"

@using ClosedXML.Excel;
@using HRIS.Contracts;
@using SKM.Shared.Dtos;
@using SKM.Shared.Helpers;

@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient httpClient
@inject IDialogService DialogService

<MudPaper Class="mb-4">
   <MudGrid Class="d-flex justify-center">
      <MudItem xs="3">
         <MudDateRangePicker @ref="tglPeriode" @bind-DateRange="_dateRange" Margin="Margin.Dense" PlaceholderStart="Dari" PlaceholderEnd="Sampai" Variant="Variant.Outlined" DisableToolbar="true" Label="Periode"></MudDateRangePicker>
      </MudItem>
      <MudItem xs="3">
         <MudSelect T="string" @ref="selectGroup" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("All")">Semua</MudSelectItem>
            @foreach (var g in groupDTOs) {
               <MudSelectItem Value="@g.GroupDesc">@g.GroupDesc</MudSelectItem>
            }
         </MudSelect>
      </MudItem>
      <MudItem xs="4" Class="align-center d-flex justify-center">
         <MudButtonGroup Variant="Variant.Filled" Color="Color.Success">
            <MudButton Disabled="@_processing" StartIcon="@Icons.Material.Filled.Preview" OnClick="PrintPreview" Size="Size.Small">
               @if (_processing) {
                  <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                  <MudText Class="ms-2">...Processing</MudText>
               }
               else {
                  <MudText>Proses</MudText>
               }
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="@(async() => await PrintReport())">
               Print
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.ImportExport" Size="Size.Small" OnClick="@(async() => await ExportToExcel())">
               To Excel
            </MudButton>

         </MudButtonGroup>

      </MudItem>
   </MudGrid>
</MudPaper>

<MudTable ServerData="@(new Func<TableState, Task<TableData<ExceptionDTO>>>(ServerReload))"
          Dense="true" Hover="true" @ref="tableTidakHadir">
   <ToolBarContent>
      <MudText Typo="Typo.h6">Laporan Karyawan Tidak Hadir</MudText>
      <MudSpacer />

      <MudSpacer />
      <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
   </ToolBarContent>
   <HeaderContent>
      <MudTh><MudTableSortLabel SortLabel="grupKerja_field" T="ExceptionDTO">Grup Kerja</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nik_field" T="ExceptionDTO">NIK</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nama_field" T="ExceptionDTO">Nama</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="keterangan_field" T="ExceptionDTO">Keterangan Tidak Hadir</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="dari_field" T="ExceptionDTO">Dari</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="sampai_field" T="ExceptionDTO">Sampai</MudTableSortLabel></MudTh>

   </HeaderContent>
   <RowTemplate>
      <MudTd DataLabel="Grup Kerja">@context.GrupKerja</MudTd>
      <MudTd DataLabel="NIK">@context.NIK</MudTd>
      <MudTd DataLabel="Nama">@context.Nama</MudTd>
      <MudTd DataLabel="Keterangan Tidak Hadir">@context.ExceptionName</MudTd>
      <MudTd DataLabel="Dari">@context.StartDate.Value.Date.ToString("dd-MM-yyyy")</MudTd>
      <MudTd DataLabel="Sampai">@context.EndDate.Value.Date.ToString("dd-MM-yyyy")</MudTd>
   </RowTemplate>
   <NoRecordsContent>
      <MudText>No matching records found</MudText>
   </NoRecordsContent>
   <LoadingContent>
      <MudText>Loading...</MudText>
   </LoadingContent>
   <PagerContent>
      <MudTablePager />
   </PagerContent>
</MudTable>

<style type="text/css">
   /* @@media screen, print{ */
      #hadir {
         font-family: Arial, Helvetica, sans-serif;
         border-collapse: collapse;
         width: 100%;
