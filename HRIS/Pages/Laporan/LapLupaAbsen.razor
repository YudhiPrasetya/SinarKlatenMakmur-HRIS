@page "/lapKaryawanLupaAbsen"

@using ClosedXML.Excel;
@using HRIS.Contracts;
@using SKM.Shared.Dtos;
@using SKM.Shared.Helpers;

@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient httpClient
@inject IDialogService DialogService

<MudPaper Class="mb-4">
   <MudGrid Class="d-flex justify-center">
      <MudItem xs="3">
         <MudDateRangePicker @ref="tglPeriode" @bind-DateRange="_dateRange" Margin="Margin.Dense" PlaceholderStart="Dari" PlaceholderEnd="Sampai" Variant="Variant.Outlined" DisableToolbar="true" Label="Periode"></MudDateRangePicker>
      </MudItem>
      <MudItem xs="3">
         <MudSelect T="string" @ref="selectGroup" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("All")">Semua</MudSelectItem>
            @foreach (var g in groupDTOs) {
               <MudSelectItem Value="@g.GroupDesc">@g.GroupDesc</MudSelectItem>
            }
         </MudSelect>
      </MudItem>
      <MudItem xs="4" Class="align-center d-flex justify-center">
         <MudButtonGroup Variant="Variant.Filled" Color="Color.Success">
            <MudButton Disabled="@_processing" StartIcon="@Icons.Material.Filled.Preview" OnClick="PrintPreview" Size="Size.Small">
               @if (_processing) {
                  <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                  <MudText Class="ms-2">...Processing</MudText>
               }
               else {
                  <MudText>Proses</MudText>
               }
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="@(async() => await PrintReport())">
               Print
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.ImportExport" Size="Size.Small" OnClick="@(async() => await ExportToExcel())">
               To Excel
            </MudButton>

         </MudButtonGroup>

      </MudItem>
   </MudGrid>
</MudPaper>

<MudTable ServerData="@(new Func<TableState, Task<TableData<LupaAbsenDTO>>>(ServerReload))"
          Dense="true" Hover="true" @ref="tableLupaAbsen">
   <ToolBarContent>
      <MudText Typo="Typo.h6">Laporan Lupa Absen</MudText>
      <MudSpacer />

      <MudSpacer />
      <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
   </ToolBarContent>
   <HeaderContent>
      <MudTh><MudTableSortLabel SortLabel="grupKerja_field" T="LupaAbsenDTO">Grup Kerja</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="tanggal_field" T="LupaAbsenDTO">Tanggal</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nik_field" T="LupaAbsenDTO">NIK</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nama_field" T="LupaAbsenDTO">Nama</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="lupaAbsen_field" T="LupaAbsenDTO">Lupa Absen</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="jam_field" T="LupaAbsenDTO">Jam</MudTableSortLabel></MudTh>

   </HeaderContent>
   <RowTemplate>
      <MudTd DataLabel="GrupKerja">@context.GrupKerja</MudTd>
      <MudTd DataLabel="Tanggal">@context.Tanggal.Value.ToString("dd-MM-yyyy")</MudTd>
      <MudTd DataLabel="NIK">@context.NIK</MudTd>
      <MudTd DataLabel="Nama">@context.NamaKaryawan</MudTd>
      <MudTd DataLabel="LupaAbsen">@context.Absen</MudTd>
      <MudTd DataLabel="Jam">@context.Jam</MudTd>
   </RowTemplate>
   <NoRecordsContent>
      <MudText>No matching records found</MudText>
   </NoRecordsContent>
   <LoadingContent>
      <MudText>Loading...</MudText>
   </LoadingContent>
   <PagerContent>
      <MudTablePager />
   </PagerContent>
</MudTable>

<style>
   #hadir {
      font-family: Arial, Helvetica, sans-serif;
      border-collapse: collapse;
      width: 100%;
   }

      #hadir td, #hadir th {
         border: 1px solid #ddd;
         padding: 8px;
      }

      #hadir tr:nth-child(even) {
         background-color: #f2f2f2;
      }

      #hadir tr:hover {
         background-color: #ddd;
      }

      #hadir th {
         padding-top: 12px;
         padding-bottom: 12px;
         text-align: left;
         background-color: #04AA6D;
         color: white;
      }
</style>

@if (printing == true) {
   <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseReport" Size="Size.Small" Class="mt-4">Close</MudButton>
   <div id="printable">
      <table style="width: 100%;" id="hadir">
         <thead>
            <tr>
               <th>Grup Kerja</th>
               <th>Tanggal</th>
               <th>NIK</th>
               <th>Nama</th>
               <th>Lupa Absen</th>
               <th>Jam</th>
            </tr>
         </thead>
         <tbody>
            @foreach (var h in listLupaAbsen) {
               <tr>
                  <td>@h.GrupKerja</td>
                  <td>@h.Tanggal</td>
                  <td>@h.NIK</td>
                  <td>@h.NamaKaryawan</td>
                  <td>@h.Absen</td>
                  <td>@h.Jam</td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {
   [Inject] ILupaAbsenService lupaAbsenService { get; set; }
   [Inject] IGroupService groupService { get; set; }

   private IEnumerable<LupaAbsenDTO> lupaAbsenDTOs { get; set; } = new List<LupaAbsenDTO>();
   private IEnumerable<LupaAbsenDTO> pagedData;
   private List<GroupDTO> groupDTOs { get; set; } = new();

   private MudTable<LupaAbsenDTO> tableLupaAbsen;
   private MudDateRangePicker tglPeriode;
   private DateRange _dateRange;
   private MudSelect<string> selectGroup;
   private bool _processing = false;
   private string searchString = null;
   private int totalItems;
   string group = "SK-STAFF";
   string startDate = DateConversions.DateToString(DateTime.Now.Date);
   string endDate = DateConversions.DateToString(DateTime.Now.Date);

   private RenderFragment html;
   private bool printing = false;
   private List<LupaAbsenDTO> listLupaAbsen = new();
   public LupaAbsenData lupaAbsenData;

   protected override async Task OnInitializedAsync() {
      // return base.OnInitializedAsync();
      groupDTOs = await groupService.GetListGroupsAsync();
   }

   private async Task<TableData<LupaAbsenDTO>> ServerReload(TableState state) {

      lupaAbsenDTOs = await lupaAbsenService.GetByGroupAndDate(group, startDate, endDate);
      await Task.Delay(50);
      lupaAbsenDTOs = lupaAbsenDTOs.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.GrupKerja.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.Tanggal.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.NamaKaryawan.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.Keterangan.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.Jam.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if ($"{element.GrupKerja} {element.Tanggal.ToString()} {element.NIK} {element.NamaKaryawan} {element.Keterangan} {element.Jam.ToString()}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = lupaAbsenDTOs.Count();
      switch (state.SortLabel) {
         case "grupKerja_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.GrupKerja);
         break;
         case "tanggal_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.Tanggal);
         break;
         case "nik_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.NIK);
         break;
         case "nama_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.NamaKaryawan);
         break;
         case "lupaAbsen_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.Keterangan);
         break;
         case "jam_field":
         lupaAbsenDTOs = lupaAbsenDTOs.OrderByDirection(state.SortDirection, o => o.Jam);
         break;

      }

      pagedData = lupaAbsenDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<LupaAbsenDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   private void OnSearch(string text) {
      searchString = text;
      tableLupaAbsen.ReloadServerData();
   }

   async Task PrintPreview() {
      _processing = true;
      string strGroup = selectGroup.Value;
      group = strGroup.Replace("/", "-");

      DateTime date1 = _dateRange.Start.Value.Date;
      startDate = DateConversions.DateToString(date1.Date);

      DateTime date2 = _dateRange.End.Value.Date;
      endDate = DateConversions.DateToString(date2.Date);

      await tableLupaAbsen.ReloadServerData();
      await Task.Delay(2000);
      _processing = false;
   }

   private void CloseReport() {
      printing = false;
      StateHasChanged();
   }

   protected async Task ExportToExcel() {
      // await kehadiranService.ExportToExcel(group, startDate, endDate);
      var response = await httpClient.GetAsync($"{BaseUrl.ServerBaseUrl}/LupaAbsen/ExportToExcel/{group}/{startDate}/{endDate}");
      // response.EnsureSuccessStatusCode();
      if (response.IsSuccessStatusCode) {
         var fileBytes = await response.Content.ReadAsByteArrayAsync();
         var fileName = "LupaAbsen.xlsx";
         await JSRuntime.InvokeAsync<object>("saveAsFile", fileName, Convert.ToBase64String(fileBytes));

      }
   }

   async Task PrintReport() {
      listLupaAbsen = await lupaAbsenService.GetByGroupAndDate(group, startDate, endDate);
      printing = true;
      StateHasChanged();
      await JSRuntime.InvokeVoidAsync("Print");

      // var parameters = new DialogParameters {
      //    ["listHadir"] = listHadir
      // };

      // var options = new DialogOptions() { CloseButton = false, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };

      // var dialog = await DialogService.ShowAsync<KehadiranData>("-", parameters, options);
      // var result = await dialog.Result;

      // kehadiranData.listHadir = listHadir;
      // StateHasChanged();
      // await JSRuntime.InvokeAsync<object>("open", new object[] { "/KehadiranData", "_blank" });

      // if (!result.Canceled) {
      //    await tableJadwalKerjaKaryawan.ReloadServerData();
      // }
   }


}

