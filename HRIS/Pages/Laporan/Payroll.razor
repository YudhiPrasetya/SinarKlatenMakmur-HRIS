         await JSRuntime.InvokeVoidAsync("openPDFInNewTab", fileBytes);

         await Task.Delay(300);
         _printProcessing = false;
      }
   }

   private async Task<TableData<PayrollPreviewDTO>> ServerReload(TableState state) {
      if(group is null){
         jadwalKehadiranDTOs = await jadwalKehadiranService!.GetByDateRange(startDate, endDate);
         employeeDTOs = await employeeService!.GetListEmployeesAsync();
         gajiDanTunjanganDTOs = await gajiDanTunjanganService!.GetGajiListAsync();
         SPLDTOs = await SPLService!.GetByDateRange(startDate, endDate);
      }
      else {
         jadwalKehadiranDTOs = await jadwalKehadiranService!.GetByGroupAndDateRange(group, startDate, endDate);
         employeeDTOs = await employeeService!.GetByGroupName(group);
         gajiDanTunjanganDTOs = await gajiDanTunjanganService!.GetByGroupName(group);
         SPLDTOs = await SPLService!.GetByGroupAndDate(group, startDate, endDate);
      }
      // gajiDanTunjanganDTOs = await gajiDanTunjanganService!.GetGajiListAsync();
      // groupDTOs = await groupService!.GetListGroupsAsync();
      jamKerjaDTO = await jamKerjaService!.GetJamKerja(1);

      DateTime sDate = DateConversions.StringToDate(startDate);
      DateTime eDate = DateConversions.StringToDate(endDate);
      periode = $"{sDate.ToString("dd-MM-yyyy")} s/d {eDate.ToString("dd-MM-yyyy")}";

      // string? groupDesc = groupDTO?.GroupDesc;
      // group = groupDesc?.Replace("/", "-").Replace(" ", "_");

      // SPLDTOs = await SPLService!.GetByGroupAndDate(group, startDate, endDate);

      // kehadiranDTOs = await kehadiranService!.GetByGroupAndDate(group, startDate, endDate);
      // jadwalKehadiranDTOs = await jadwalKehadiranService!.GetByGroupAndDateRange(group, startDate, endDate);

      // if (groupDTO?.GroupDesc != "SK/SECURITY" && groupDTO?.GroupDesc != "SK/SECURITY WANITA") {
      //    jadwalKerjaKaryawanDTOs = await jadwalKerjaKaryawanService!.GetByGroupAndDate(group, startDate, endDate);

      //    payrollPreviewDTOs = HitungPayroll.Payroll(periode, employeeDTOs, jadwalKerjaKaryawanDTOs, kehadiranDTOs, SPLDTOs, gajiDanTunjanganDTOs, jamKerjaDTO);
      // }
      // else {
      //    jadwalKerjaSecurityDTOs = await jadwalKerjaSecurityService.GetByDateRange(startDate, endDate);

      //    payrollPreviewDTOs = HitungPayroll.PayrollSecurity(groupDTO.GroupDesc, periode, employeeDTOs, jadwalKerjaSecurityDTOs, kehadiranDTOs, SPLDTOs, gajiDanTunjanganDTOs, jamKerjaDTO);
      // }
      payrollPreviewDTOs = HitungPayroll.Payroll(periode, employeeDTOs, jadwalKehadiranDTOs, SPLDTOs, gajiDanTunjanganDTOs, jamKerjaDTO);

      await Task.Delay(300);
      payrollPreviewDTOs = payrollPreviewDTOs.Where(element =>
      {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.Nama!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.NIK!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.GrupKerja!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
         if ($"{element.Nama} {element.NIK} {element.GrupKerja}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = payrollPreviewDTOs.Count();
      switch (state.SortLabel)
      {
         case "grup_field":
         payrollPreviewDTOs = payrollPreviewDTOs.OrderByDirection(state.SortDirection, o => o.GrupKerja);
         break;
      }

      pagedData = payrollPreviewDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<PayrollPreviewDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   private void OnSearch(string text) {
      searchString = text;
      payrollTable!.ReloadServerData();
   }

