@page "/lapAkhirKontrak"

@using ClosedXML.Excel;
@using HRIS.Contracts;
@using SKM.Shared.Dtos;
@using SKM.Shared.Helpers;

@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient httpClient
@inject IDialogService DialogService

<MudPaper Class="mb-4">
   <MudGrid Class="d-flex justify-center">
      <MudItem xs="3">
         <MudDateRangePicker @ref="tglPeriode" @bind-DateRange="_dateRange" Margin="Margin.Dense" PlaceholderStart="Dari" PlaceholderEnd="Sampai" Variant="Variant.Outlined" DisableToolbar="true" Label="Periode"></MudDateRangePicker>
      </MudItem>
      <MudItem xs="3">
         <MudSelect T="string" @ref="selectGroup" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("All")">Semua</MudSelectItem>
            @foreach (var g in groupDTOs) {
               <MudSelectItem Value="@g.GroupDesc">@g.GroupDesc</MudSelectItem>
            }
         </MudSelect>
      </MudItem>
      <MudItem xs="4" Class="align-center d-flex justify-center">
         <MudButtonGroup Variant="Variant.Filled" Color="Color.Success">
            <MudButton Disabled="@_processing" StartIcon="@Icons.Material.Filled.Preview" OnClick="PrintPreview" Size="Size.Small">
               @if (_processing) {
                  <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                  <MudText Class="ms-2">...Processing</MudText>
               }
               else {
                  <MudText>Proses</MudText>
               }
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="@(async() => await PrintReport())">
               Print
            </MudButton>

            <MudButton StartIcon="@Icons.Material.Filled.ImportExport" Size="Size.Small" OnClick="@(async() => await ExportToExcel())">
               To Excel
            </MudButton>

         </MudButtonGroup>
      </MudItem>
   </MudGrid>
</MudPaper>

<MudTable ServerData="@(new Func<TableState, Task<TableData<EmployeeDTO>>>(ServerReload))"
          Dense="true" Hover="true" @ref="tableEmployee">
   <ToolBarContent>
      <MudText Typo="Typo.h6">Laporan Akhir Kontrak</MudText>
      <MudSpacer />

      <MudSpacer />
      <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
   </ToolBarContent>
   <HeaderContent>
      <MudTh><MudTableSortLabel SortLabel="grupKerja_field" T="EmployeeDTO">Grup Kerja</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nik_field" T="EmployeeDTO">NIK</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="nama_field" T="EmployeeDTO">Nama</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="awalKontrak_field" T="EmployeeDTO">Awal Kontrak</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="akhirKontrak_field" T="EmployeeDTO">Akhir Kontrak</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortLabel="akhir_field" T="EmployeeDTO">Akhir(Hari)</MudTableSortLabel></MudTh>

   </HeaderContent>
   <RowTemplate>
      <MudTd DataLabel="GrupKerja">@context.GroupName</MudTd>
      <MudTd DataLabel="NIK">@context.NIK</MudTd>
      <MudTd DataLabel="Nama">@context.Name</MudTd>
      <MudTd DataLabel="Awal Kontrak">@context.ContractStartDate.Value.Date.ToString("dd-MM-yyyy")</MudTd>
      <MudTd DataLabel="JamPulang">@context.ContractEndDate.Value.Date.ToString("dd-MM-yyyy")</MudTd>
      <MudTd DataLabel="Terlambat">@((context.ContractEndDate.Value.Date - DateTime.Now.Date).Days)</MudTd>
   </RowTemplate>
   <NoRecordsContent>
      <MudText>No matching records found</MudText>
   </NoRecordsContent>
   <LoadingContent>
      <MudText>Loading...</MudText>
   </LoadingContent>
   <PagerContent>
      <MudTablePager />
   </PagerContent>
</MudTable>

<style>
   #hadir {
      font-family: Arial, Helvetica, sans-serif;
      border-collapse: collapse;
      width: 100%;
   }

      #hadir td, #hadir th {
         border: 1px solid #ddd;
         padding: 8px;
      }

      #hadir tr:nth-child(even) {
         background-color: #f2f2f2;
      }

      #hadir tr:hover {
         background-color: #ddd;
      }

      #hadir th {
         padding-top: 12px;
         padding-bottom: 12px;
         text-align: left;
         background-color: #04AA6D;
         color: white;
      }
</style>

@if (printing == true) {
   <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseReport" Size="Size.Small" Class="mt-4">Close</MudButton>
   <div id="printable">
      <table style="width: 100%;" id="hadir">
         <thead>
            <tr>
               <th>Grup Kerja</th>
               <th>NIK</th>
               <th>Nama</th>
               <th>Awal Kontrak</th>
               <th>Akhir Kontrak</th>
               <th>AKhir(Hari)</th>
            </tr>
         </thead>
         <tbody>
            @foreach (var e in listEmp) {
               <tr>
                  <td>@e.GroupName</td>
                  <td>@e.NIK</td>
                  <td>@e.Name</td>
                  <td>@e.ContractStartDate.Value.Date.ToString("dd-MM-yyyy")</td>
                  <td>@e.ContractEndDate.Value.Date.ToString("dd-MM-yyyy")</td>
                  <td>@(DateTime.Now.Date - e.ContractEndDate.Value.Date)</td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {
   [Inject] IEmployeeService employeeService { get; set; }
   [Inject] IGroupService groupService { get; set; }

   private IEnumerable<EmployeeDTO> EmployeeDTOs { get; set; } = new List<EmployeeDTO>();
   private IEnumerable<EmployeeDTO> pagedData;
   private List<GroupDTO> groupDTOs { get; set; } = new();

   private MudTable<EmployeeDTO> tableEmployee;
   private MudDateRangePicker tglPeriode;
   private DateRange _dateRange;
   private MudSelect<string?> selectGroup;
   private bool _processing = false;
   private string searchString = null;
   private int totalItems;
   string group = "SK-STAFF";
   string startDate = DateConversions.DateToString(DateTime.Now.Date);
   string endDate = DateConversions.DateToString(DateTime.Now.Date);

   private RenderFragment html;
   private bool printing = false;
   private List<EmployeeDTO> listEmp = new();
   public KehadiranData kehadiranData;

   protected override async Task OnInitializedAsync() {
      // return base.OnInitializedAsync();
      groupDTOs = await groupService.GetListGroupsAsync();
   }

   private async Task<TableData<EmployeeDTO>> ServerReload(TableState state) {

      EmployeeDTOs = await employeeService.GetByGroupAndDate(group, startDate, endDate);
      await Task.Delay(50);
      EmployeeDTOs = EmployeeDTOs.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.GroupName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.ContractStartDate.Value.Date.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.ContractEndDate.Value.Date.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if ($"{element.GroupName} {element.NIK} {element.Name} {element.ContractStartDate.Value.Date.ToString()} {element.ContractEndDate.Value.Date.ToString()}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = EmployeeDTOs.Count();
      switch (state.SortLabel) {
         case "grupKerja_field":
         EmployeeDTOs = EmployeeDTOs.OrderByDirection(state.SortDirection, o => o.GroupName);
         break;

         case "nik_field":
         EmployeeDTOs = EmployeeDTOs.OrderByDirection(state.SortDirection, o => o.NIK);
         break;

         case "nama_field":
         EmployeeDTOs = EmployeeDTOs.OrderByDirection(state.SortDirection, o => o.Name);
         break;

         case "awalKontrak_field":
         EmployeeDTOs = EmployeeDTOs.OrderByDirection(state.SortDirection, o => o.ContractStartDate.Value.Date);
         break;

         case "jamPulang_field":
         EmployeeDTOs = EmployeeDTOs.OrderByDirection(state.SortDirection, o => o.ContractEndDate.Value.Date);
         break;
      }

      pagedData = EmployeeDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<EmployeeDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   private void OnSearch(string text) {
      searchString = text;
      tableEmployee.ReloadServerData();
   }

   async Task PrintPreview() {
      _processing = true;
      string strGroup = selectGroup.Value;
      group = strGroup.Replace("/", "-");

      DateTime date1 = _dateRange.Start.Value.Date;
      startDate = DateConversions.DateToString(date1.Date);

      DateTime date2 = _dateRange.End.Value.Date;
      endDate = DateConversions.DateToString(date2.Date);

      await tableEmployee.ReloadServerData();
      await Task.Delay(2000);
      _processing = false;
   }

   private void CloseReport() {
      printing = false;
      StateHasChanged();
   }

   protected async Task ExportToExcel() {
      // await kehadiranService.ExportToExcel(group, startDate, endDate);
      var response = await httpClient.GetAsync($"{BaseUrl.ServerBaseUrl}/Employees/ExportToExcel/{group}/{startDate}/{endDate}");
      // response.EnsureSuccessStatusCode();
      if (response.IsSuccessStatusCode) {
         var fileBytes = await response.Content.ReadAsByteArrayAsync();
         var fileName = "KaryawanAkhirKontrak.xlsx";
         await JSRuntime.InvokeAsync<object>("saveAsFile", fileName, Convert.ToBase64String(fileBytes));

      }
   }

   async Task PrintReport() {
      listEmp = await employeeService.GetByGroupAndDate(group, startDate, endDate);
      printing = true;
      StateHasChanged();
      await JSRuntime.InvokeVoidAsync("Print");

      // var parameters = new DialogParameters {
      //    ["listHadir"] = listHadir
      // };

      // var options = new DialogOptions() { CloseButton = false, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };

      // var dialog = await DialogService.ShowAsync<KehadiranData>("-", parameters, options);
      // var result = await dialog.Result;

      // kehadiranData.listHadir = listHadir;
      // StateHasChanged();
      // await JSRuntime.InvokeAsync<object>("open", new object[] { "/KehadiranData", "_blank" });

      // if (!result.Canceled) {
      //    await tableJadwalKerjaKaryawan.ReloadServerData();
      // }
   }


}