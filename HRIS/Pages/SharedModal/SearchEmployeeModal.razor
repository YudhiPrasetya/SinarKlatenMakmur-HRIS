@using HRIS.Contracts;
@using HRIS.Services;
@using SKM.Shared.Dtos;

@inject IDialogService DialogService;

<style>
   .selected {
       background-color: #1E88E5 !important;
   }

   .selected > td {
      color: white !important;
   }

   .selected > td .mud-input {
      color: white !important;
   }
</style>

<MudDialog>
	<DialogContent>
      <MudTable Dense="true" Class="cursor-pointer" Items="@EmployeeDTOS" Hover="true" Striped="true" Filter="new Func<EmployeeDTO, bool>(FilterFunc1)" T="EmployeeDTO" @ref="employeeTable" OnRowClick="RowClickEvent" RowClassFunc="@SelectedRowClassFunc" @bind-bind-SelectedItems="selectedEmps">
         <ToolBarContent>
            <MudText Typo="Typo.h6">@ModalLabel</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="strSearch" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" ></MudTextField>
            <MudSpacer />
            <MudButton Class="ml-2 mr-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" Disabled="@disable" Color="Color.Success" Size="Size.Small" IconSize="Size.Small" OnClick="SelectedEmployee">Pilih</MudButton>
            <MudButton Class="ml-2 mr-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Secondary" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
            
         </ToolBarContent>
         <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>NIK</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Group Id</MudTh>
            <MudTh>Group Name</MudTh>
            <MudTh>Department ID</MudTh>
            <MudTh>Department Name</MudTh>
         </HeaderContent>
         <RowTemplate>
            <MudTd DataLabel="ID">@context.EmployeeId</MudTd>
            <MudTd DataLabel="NIK">@context.NIK</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Group ID">@context.GroupID</MudTd>
            <MudTd DataLabel="Group Name">@context.GroupName</MudTd>
            <MudTd DataLabel="Department ID">@context.DepartmentId</MudTd>
            <MudTd DataLabel="Department Name">@context.DepartmentName</MudTd>
         </RowTemplate>
         <PagerContent>
            <MudTablePager />
         </PagerContent>
      </MudTable>
	</DialogContent>
</MudDialog>

@code {
   [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
   private MudTable<EmployeeDTO> employeeTable;
   [Parameter]public string? ModalLabel { get; set; }
   [Parameter]public IEnumerable<EmployeeDTO>? EmployeeDTOS { get; set; }
   //[Parameter]public IEnumerable<GroupDTO>? GroupDTOS { get; set; }
   private string strSearch = "";
   private EmployeeDTO selectedItem = null;
   private bool disable = true;

   private bool FilterFunc1(EmployeeDTO employeeDTO) => FilterFunc(employeeDTO, strSearch);

   private bool FilterFunc(EmployeeDTO employeeDTO, string sSearch) {
      if (string.IsNullOrWhiteSpace(sSearch)) return true;
      if (employeeDTO.NIK.Contains(sSearch, StringComparison.OrdinalIgnoreCase)) return true;
      if (employeeDTO.Name.Contains(sSearch, StringComparison.OrdinalIgnoreCase)) return true;
      if (employeeDTO.GroupName.Contains(sSearch, StringComparison.OrdinalIgnoreCase)) return true;
      if($"{employeeDTO.EmployeeId}".Contains(sSearch)) return true;
      return false;
   }
   private int selectedRowNumber = -1;
   private IEnumerable<EmployeeDTO> selectedEmps = new List<EmployeeDTO>();

   private void RowClickEvent(TableRowClickEventArgs<EmployeeDTO> args) {
      selectedItem = args.Item;
      disable = false;
      //Console.WriteLine(selectedItem.Name);
   }

   private void SelectedEmployee() {
      //Console.WriteLine(selectedItem.Name);
      MudDialog?.Close(DialogResult.Ok(selectedItem));
   }

   private void Cancel() {
      MudDialog.Cancel();
   }

   private string SelectedRowClassFunc(EmployeeDTO employeeDTO, int rowNumber) {
      if (selectedRowNumber == rowNumber) {
         selectedRowNumber = -1;
         return string.Empty;
      }
      else if (employeeTable.SelectedItem != null && employeeTable.SelectedItem.Equals(employeeDTO)) {
         selectedRowNumber = rowNumber;
         return "selected";
      }
      else {
         return string.Empty;
      }
   }

}
