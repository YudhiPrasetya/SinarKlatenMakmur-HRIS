   private async void AddNewUser() {
      TokenDTO tokenDTO = await TokenService.GetToken();
      if(tokenDTO.Role != "Admin") {
         // Snackbar.Add("Anda tidak berhak mengakses!", Severity.Warning);
         var dialogOptions1 = new DialogOptions {
               Position = DialogPosition.TopCenter,
               FullWidth = true,
               ClassBackground = "AddUserDialogClass",
               MaxWidth = MaxWidth.Small,
               CloseButton = true,
               DisableBackdropClick = true,
               CloseOnEscapeKey = false
         };
         await DialogService.ShowAsync<ForbidenModal>("Forbiden", dialogOptions1);
      }
      var dialogOptions2 = new DialogOptions {
