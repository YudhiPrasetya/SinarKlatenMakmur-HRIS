   public void Dispose() => Interceptor.DisposeEvent();

   private async Task<TableData<UserDTO>> ServerReload(TableState state) {
      // IEnumerable<UserDTO> data = await userService.GetUsers();
      var response = await userService.GetUsers();
      if (response?.StatusCode == System.Net.HttpStatusCode.OK) {
         await Task.Delay(300);
         var data = await response.Content.ReadFromJsonAsync<IEnumerable<UserDTO>>();
         data = data?.Where(el => {
            if (string.IsNullOrWhiteSpace(searchString)) return true;
            if (el.UserId.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (el.UserName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (el.Role.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (el.IsActive.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;

            if ($"{el.UserId}{el.UserName}{el.Role}{el.IsActive.ToString()}".Contains(searchString)) return true;
            return false;
         }).ToArray();
         totalItems = data.Count();
         switch (state.SortLabel) {
            case "id_field":
            data = data.OrderByDirection(state.SortDirection, o => o.UserId);
            break;
            case "username_field":
            data = data.OrderByDirection(state.SortDirection, o => o.UserName);
            break;
            case "role_field":
            data = data.OrderByDirection(state.SortDirection, o => o.Role);
            break;
            case "isactive_field":
            data = data.OrderByDirection(state.SortDirection, o => o.IsActive);
            break;
         }
         pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
         return new TableData<UserDTO>() { TotalItems = totalItems, Items = pagedData };
      }
      return null;
   }

   private void RowClickEvent(TableRowClickEventArgs<UserDTO> args) {
      // clickedEvents.Add("Row has been clicked");

      userDTO.UserId = args.Item.UserId;
      userDTO.UserName = args.Item.UserName;
      userDTO.Password = args.Item.Password;
      userDTO.Role = args.Item.Role;
      userDTO.IsActive = args.Item.IsActive;
      DisabledEdit = false;
      Disabled = true;
   }

   private string SelectedRowClassFunc(UserDTO userDTO, int rowNumber) {
      if (selectedRowNumber == rowNumber) {
         selectedRowNumber = -1;
         // clickedEvents.Add("Selected Row: None");
         return string.Empty;
      }
      else if (userTable.SelectedItem != null && userTable.SelectedItem.Equals(userDTO)) {
         selectedRowNumber = rowNumber;
         // clickedEvents.Add($"Selected Row: {rowNumber}");
         return "selected";
      }
      else {
         return string.Empty;
      }
   }

   private void OnSearch(string text) {
      searchString = text;
      userTable.ReloadServerData();
   }

