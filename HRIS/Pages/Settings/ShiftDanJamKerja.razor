							<MudTd DataLabel="Deskripsi">@context.Deskripsi</MudTd>
							<MudTd DataLabel="Jadwal Masuk">@context.JadwalMasuk</MudTd>
							<MudTd DataLabel="Jadwal Pulang">@context.JadwalPulang</MudTd>
