	private async Task<TableData<JadwalShiftKaryawanDTO>> JadwalShiftKaryawanReload(TableState state) {
		IEnumerable<JadwalShiftKaryawanDTO> data = await jadwalShiftKaryawanService!.GetJadwalShiftKaryawan();
		await Task.Delay(300);
		data = data.Where(element => {
			if (string.IsNullOrWhiteSpace(searchString))
				return true;
			if (element.Id.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
				return true;
			if (element.Deskripsi!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
