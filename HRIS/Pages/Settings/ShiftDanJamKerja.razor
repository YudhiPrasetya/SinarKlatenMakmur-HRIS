	async Task AddNewJadwalShiftDepartemen() {
		var dialogOptions = new DialogOptions { ClassBackground = "backdrops-style", DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Small, Position = DialogPosition.Center };

		var dialogParameters = new DialogParameters<AddJadwalShiftDepartemenDialog>();
		dialogParameters.Add("groupDTOs", groupDTOs);

		var dialog = await DialogService.ShowAsync<AddJadwalShiftDepartemenDialog>("Tambah Data Jadwal Shift Departemen", dialogParameters,dialogOptions);

		var dialogResult = await dialog.Result;
		if (!dialogResult.Canceled) {
			await jadwalShiftDepartemenTable!.ReloadServerData();
		}
	}

	async Task AddNewJadwalShiftKaryawan() {
		var dialogOptions = new DialogOptions { ClassBackground = "backdrops-style", DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Small, Position = DialogPosition.Center };
		var parameters = new DialogParameters {
				["listNamaHari"] = listNamaHari
			};
		var dialog = await DialogService.ShowAsync<AddJadwalShiftKaryawanDialog>("Tambah Data Jadwal Shift Karyawan", parameters, dialogOptions);

		var dialogResult = await dialog.Result;
		if (!dialogResult.Canceled) {
			await jadwalShiftKaryawanTable!.ReloadServerData();
		}
	}

