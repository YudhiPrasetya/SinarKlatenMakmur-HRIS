<style>
	.backdrops-style {
		backdrop-filter: blur(5px);
	}
</style>

@code {
	[Inject] IJamKerjaService? jamKerjaService { get; set; }
	[Inject] IJadwalShiftKaryawanService? jadwalShiftKaryawanService { get; set; }
	[Inject] IJadwalShiftDepartemenService? jadwalShiftDepartemenService { get; set; }
	[Inject] IJadwalShiftSecurityServicecs? jadwalShiftSecurityService { get; set; }
	[Inject] IGroupService? groupService { get; set; }

	JamKerjaDTO jamKerjaDTO { get; set; } = new();
	List<JadwalShiftKaryawanDTO> jadwalShiftKaryawanDTOs { get; set; } = new();
	List<JadwalShiftSecurityDTO> jadwalShiftSecurityDTOs { get; set; } = new();
	List<GroupDTO> groupDTOs { get; set; } = new();

	MudTable<JadwalShiftKaryawanDTO>? jadwalShiftKaryawanTable;
	MudTable<JadwalShiftDepartemenDTO>? jadwalShiftDepartemenTable;
	MudTable<JadwalShiftSecurityDTO>? jadwalShiftSecurityTable;
	MudTextField<string>? jamKerja_Keterangan;
	MudTextField<int>? jamKerja_Durasi;
	MudNumericField<int>? pembagiPayroll;

	JadwalShiftKaryawanDTO? selectedJadwalShiftKaryawan;
	JadwalShiftSecurityDTO? selectedJadwalShiftSecurity;
	JadwalShiftDepartemenDTO? selectedJadwalShiftDepartemen;

	JadwalShiftKaryawanDTO? jskDTOBeforeEdit;
	JadwalShiftSecurityDTO? jssDTOBeforeEdit;
	JadwalShiftDepartemenDTO? jsdDTOBeforeEdit;

	string searchString = "";
	string searchString1 = "";
	string searchString2 = "";

	int totalItems = 0;
	int totalItems1 = 0;
	int totalItems2 = 0;

	IEnumerable<JadwalShiftKaryawanDTO>? pagedData;
	IEnumerable<JadwalShiftDepartemenDTO>? pagedShiftDepartemenData;
	IEnumerable<JadwalShiftSecurityDTO>? pagedData1;

	private List<NamaHari> listNamaHari = new();

	protected override async Task OnInitializedAsync() {
		// return base.OnInitializedAsync();
		jamKerjaDTO = await jamKerjaService!.GetJamKerja(1);
		groupDTOs = await groupService!.GetListGroupsAsync();
		// jadwalShiftKaryawanDTOs = await jadwalShiftKaryawanService.GetJadwalShiftKaryawan();
		// jadwalShiftSecurityDTOs = await jadwalShiftSecurityServicecs.GetJadwalShiftSecurityAsync();
		listNamaHari.Add(new NamaHari { HariNum = "1", HariName = "Senin" });
		listNamaHari.Add(new NamaHari { HariNum = "2", HariName = "Selasa" });
		listNamaHari.Add(new NamaHari { HariNum = "3", HariName = "Rabu" });
		listNamaHari.Add(new NamaHari { HariNum = "4", HariName = "Kamis" });
		listNamaHari.Add(new NamaHari { HariNum = "5", HariName = "Jumat" });
		listNamaHari.Add(new NamaHari { HariNum = "6", HariName = "Sabtu" });
	}

	async Task UpdateJamKerja() {
		JamKerjaDTO updatedData;
		if(jamKerjaDTO == null) {
			//add new
			JamKerjaDTO jkDTO = new() {
					Deskripsi = jamKerjaDTO!.Deskripsi,
					DurasiPerHari = jamKerjaDTO.DurasiPerHari,
					PembagiPayroll = jamKerjaDTO.PembagiPayroll
				};
			updatedData = await jamKerjaService!.AddJamKerja(jkDTO);

		}
		else {
			updatedData = await jamKerjaService!.UpdateJamKerja(jamKerjaDTO);
		}
		Snackbar.Add("Data jam kerja berhasil di updated", Severity.Success, config =>
		{
			config.HideTransitionDuration = 500;
		});
	}

	private void jskBackupItem(object el) {
		jskDTOBeforeEdit = new()
			{
				Id = ((JadwalShiftKaryawanDTO)el).Id,
				Deskripsi = ((JadwalShiftKaryawanDTO)el).Deskripsi,
				JadwalMasuk = ((JadwalShiftKaryawanDTO)el).JadwalMasuk,
