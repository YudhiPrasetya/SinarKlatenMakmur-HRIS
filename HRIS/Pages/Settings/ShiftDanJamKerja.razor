						<ToolBarContent>
							<MudText Typo="Typo.h6"><strong>Tabel Jadwal Shift Departemen</strong></MudText>
							<MudSpacer />
							<MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" OnClick="AddNewJadwalShiftDepartemen" Size="Size.Small"></MudFab>
						</ToolBarContent>
						<HeaderContent>
							<MudTh><MudTableSortLabel SortLabel="Id_Field" T="JadwalShiftDepartemenDTO">ID</MudTableSortLabel></MudTh>

							<MudTh><MudTableSortLabel SortLabel="Deskripsi_Field" T="JadwalShiftDepartemenDTO">Deskripsi</MudTableSortLabel></MudTh>

							<MudTh><MudTableSortLabel SortLabel="GrupKerja_Field" T="JadwalShiftDepartemenDTO">Grup Kerja</MudTableSortLabel></MudTh>

							<MudTh><MudTableSortLabel SortLabel="JadwalMasuk_Field" T="JadwalShiftDepartemenDTO">Jadwal Masuk</MudTableSortLabel></MudTh>

							<MudTh><MudTableSortLabel SortLabel="JadwalPulang_Field" T="JadwalShiftDepartemenDTO">Jadwal Pulang</MudTableSortLabel></MudTh>
						</HeaderContent>
						<RowTemplate>
							<MudTd DataLabel="ID">@context.Id</MudTd>
							<MudTd DataLabel="Deskripsi">@context.Keterangan</MudTd>
							<MudTd DataLabel="Grup Kerja">@context.GrupKerja</MudTd>
							<MudTd DataLabel="Jadwal Masuk">@context.JadwalMasuk</MudTd>
							<MudTd DataLabel="Jadwal Pulang">@context.JadwalPulang</MudTd>
						</RowTemplate>
						<RowEditingTemplate>
							<MudTd DataLabel="ID">@context.Id</MudTd>
							<MudTd DataLabel="Deskripsi">
								<MudTextField @bind-Value="@context.Keterangan"></MudTextField>
							</MudTd>
							<MudTd DataLabel="Grup Kerja">
								<MudTextField @bind-Value="@context.GrupKerja"></MudTextField>
