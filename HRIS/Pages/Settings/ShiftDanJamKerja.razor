	private async void jskDTOCommitted(object el) {
		JadwalShiftKaryawanDTO jskDTOCommitted = new()
			{
				Id = ((JadwalShiftKaryawanDTO)el).Id,
				Deskripsi = ((JadwalShiftKaryawanDTO)el).Deskripsi,
				JadwalMasuk = ((JadwalShiftKaryawanDTO)el).JadwalMasuk,
				JadwalPulang = ((JadwalShiftKaryawanDTO)el).JadwalPulang
			};
		var jadwal = await jadwalShiftKaryawanService!.UpdateJadwalShiftKaryawan(jskDTOCommitted);
		if(jadwal != null) {
			Snackbar.Add("Jadwal Shift Karyawan berhasil di update.", Severity.Success, c =>
			{
				c.HideTransitionDuration = 300;
			});
			await jadwalShiftKaryawanTable!.ReloadServerData();
		}
		// jskDTOCommitted.Id = ((JadwalShiftKaryawanDTO))
	}

