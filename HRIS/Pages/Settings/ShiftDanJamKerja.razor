						</PagerContent>
					</MudTable>
				</ChildContent>
			</MudExpansionPanel>

			<MudExpansionPanel>
				<TitleContent>
					<div class="d-flex">
						<MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-3" Color="Color.Secondary"></MudIcon>
						<MudText><strong>Jadwal Shift Security</strong></MudText>
					</div>
				</TitleContent>
				<ChildContent>
