@page "/shiftdanjamkerja"
@using HRIS.Components;
@using HRIS.Contracts;
@using SKM.Shared.Dtos;
@using SKM.Shared.Helpers;

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudGrid>
	<MudItem xs="10" sm="10">
		<MudExpansionPanels>
			<MudExpansionPanel>
				<TitleContent>
					<div class="d-flex">
