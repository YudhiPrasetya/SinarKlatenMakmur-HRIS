					<MudTextField @ref="jamKerja_Keterangan" @bind-Value="jamKerjaDTO.Deskripsi" T="string" Label="Keterangan" Class="mb-2"></MudTextField>
					<MudTextField @ref="jamKerja_Durasi" T="int" Label="Durasi(Jam)" Class="mb-4" @bind-Value="jamKerjaDTO.DurasiPerHari"></MudTextField>
					<MudNumericField @ref="pembagiPayroll" T="int" @bind-Value="jamKerjaDTO.PembagiPayroll" Label="Pembagi Payroll"></MudNumericField>
					<MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Outlined" Color="Color.Success" OnClick="UpdateJamKerja">Update</MudButton>
				</ChildContent>
			</MudExpansionPanel>

			<MudExpansionPanel>
				<TitleContent>
					<div class="d-flex">
						<MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-3" Color="Color.Secondary"></MudIcon>
						<MudText><strong>Jadwal Shift Karyawan</strong></MudText>
					</div>
				</TitleContent>
				<ChildContent>
					<MudTable @ref="jadwalShiftKaryawanTable" ServerData="@(new Func<TableState, Task<TableData<JadwalShiftKaryawanDTO>>>(JadwalShiftKaryawanReload))" T="JadwalShiftKaryawanDTO" Dense="true" Hover="true" CanCancelEdit="true" @bind-SelectedItem="selectedJadwalShiftKaryawan" RowEditCancel="ResetJSKItem" RowEditCommit="jskDTOCommitted" RowEditPreview="jskBackupItem" IsEditRowSwitchingBlocked="true" ApplyButtonPosition="TableApplyButtonPosition.End">
						<ToolBarContent>
							<MudText Typo="Typo.h6"><strong>Tabel Jadwal Shift Karyawan</strong></MudText>
							<MudSpacer />
							<MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" OnClick="AddNewJadwalShiftKaryawan" Size="Size.Small"></MudFab>
						</ToolBarContent>
						<HeaderContent>
							<MudTh><MudTableSortLabel SortLabel="Id_Field" T="JadwalShiftKaryawanDTO">ID</MudTableSortLabel></MudTh>
							<MudTh><MudTableSortLabel SortLabel="Deskripsi_Field" T="JadwalShiftKaryawanDTO">Deskripsi</MudTableSortLabel></MudTh>
							<MudTh><MudTableSortLabel SortLabel="JadwalMasuk_Field" T="JadwalShiftKaryawanDTO">Jadwal Masuk</MudTableSortLabel></MudTh>
							<MudTh><MudTableSortLabel SortLabel="JadwalPulang_Field" T="JadwalShiftKaryawanDTO">Jadwal Pulang</MudTableSortLabel></MudTh>
							<MudTh><MudTableSortLabel SortLabel="Inisial_Field" T="JadwalShiftKaryawanDTO">Inisial</MudTableSortLabel></MudTh>
						</HeaderContent>
						<RowTemplate>
							<MudTd DataLabel="ID">@context.Id</MudTd>
							<MudTd DataLabel="Deskripsi">@context.Deskripsi</MudTd>
							<MudTd DataLabel="Jadwal Masuk">@context.JadwalMasuk</MudTd>
							<MudTd DataLabel="Jadwal Pulang">@context.JadwalPulang</MudTd>
							<MudTd DataLabel="Inisial">@context.Initial</MudTd>
						</RowTemplate>
						<RowEditingTemplate>
							<MudTd DataLabel="ID">@context.Id</MudTd>
							<MudTd DataLabel="Deskripsi">
								<MudTextField @bind-Value="@context.Deskripsi"></MudTextField>
							</MudTd>
							<MudTd DataLabel="Jadwal Masuk">
