@page "/tidakhadir"
@using HRIS.Contracts;
@using HRIS.Pages.SharedModal;
@using HRIS.Services;
@using SKM.Shared.Dtos;
@inject ISnackbar Snackbar
@inject IDialogService DialogService;

<MudCard Class="mt-5" Elevation="1">
	<MudCardHeader>
		<CardHeaderContent>
			<MudText Typo="Typo.h6">Data Ketidakhadiran</MudText>
		</CardHeaderContent>
		<CardHeaderActions>
			@*<MudIconButton Icon="@Icons.Material.Filled.Add" Title="Tambah Data" Color="Color.Success"></MudIconButton>*@
@*			<MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Label="Tambah Data" />*@

@*         <MudButton Color="Color.Tertiary" OnClick="@((e) => addException())" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">Tambah Data</MudButton>*@
		</CardHeaderActions>
	</MudCardHeader>
	<MudCardContent>
      <MudExpansionPanels Elevation="3">
         <MudExpansionPanel @bind-IsExpanded="isOpen" HideIcon="true">
            <TitleContent>
               <div class="d-flex">
                  <MudText Color="@TitlePanelColor"><strong>@formCaption</strong></MudText>
                  <MudIcon Icon="@(isOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" class="ml-auto"></MudIcon>
               </div>
            </TitleContent>
            <ChildContent>
               <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
                  <MudGrid>
                     <MudItem xs="2">
                        <MudTextField @ref="Id" T="int" Label="Id" Required="true" Disabled="true" @bind-Value="@exceptionDTO.Id"></MudTextField>
                     </MudItem>
                  </MudGrid>
                  <MudPaper Class="d-flex justify-space-between flex-grow-1 gap-2" Elevation="0">

                     <MudTextField @bind-Value="@exceptionDTO.GrupKerja" Class="d-inline" T="string" Label="Grup Kerja" @ref="grupKerja" Disabled="true"></MudTextField>
                     <MudTextField @bind-Value="@exceptionDTO.NIK" @ref="NIK" Class="d-inline" T="string" Label="NIK" Disabled="true" Required="true" />
                     <MudTextField @bind-Value="@exceptionDTO.Nama" @ref="Nama" Class="d-inline" T="string" Label="Nama" Disabled="true" Required="true" />
                     <MudIconButton Class="d-inline" Icon="@Icons.Material.Filled.Search" Color="Color.Tertiary" OnClick="CariKaryawan" />
                  </MudPaper>
                  <MudGrid>
                     <MudItem xs="8"> 
                        <MudAutocomplete @ref="Exp" T="ExceptionTypeDTO" @bind-Value="exceptionTypeDTO"   @bind-Text="exceptionDTO.ExceptionName" Label="Alasan" SearchFunc="@Search" ResetValueOnEmptyText="true" ToStringFunc="@(e => e == null ? null : $"{e.Id}-{e.ExceptionName}")" >
                           <BeforeItemsTemplate>
                              <MudText Color="Color.Primary" Class="px-4 py-1">--Pilih Alasan--</MudText>
                           </BeforeItemsTemplate>
                        </MudAutocomplete>
@*                        <MudSelect @ref="IdException" @bind-Value="@exceptionDTO" Required="true" RequiredError="Alasan tidak hadir harus diisi!" Label="Alasan tidak hadir">
                        @foreach (var exceptionTypeDTO in ExceptionTypeDTOS) {
                              <MudSelectItem T="int" Value="@exceptionTypeDTO.Id">@exceptionTypeDTO.Id-@exceptionTypeDTO.ExceptionName</MudSelectItem>
                        }
                        </MudSelect>*@

@*                        <InputSelect @bind-Value="exceptionDTO.Id" TValue="int" id="ExceptionID" @ref="exception">
                           @foreach(var exDTO in ExceptionTypeDTOS) {
                              <option value="@exDTO.Id">@exDTO.ExceptionName</option>
                           }
                        </InputSelect>*@

                     </MudItem>
                  </MudGrid>
                  <MudGrid>
                     <MudItem xs="10">
                        <MudTextField @bind-Value="@exceptionDTO.Detail" @ref="Keterangan" T="string" Label="Keterangan" ></MudTextField>
                     </MudItem>
                  </MudGrid>
                  <MudGrid>
                     <MudItem xs="6">
                        <MudDateRangePicker DisableToolbar="true" @ref="Durasi" Placeholder="Date Range" Label="Durasi tidak hadir" PlaceholderStart="Dari" PlaceholderEnd="Sampai" @bind-DateRange="_dateRange"/>
                     </MudItem>
                  </MudGrid>
                  <MudDivider DividerType="DividerType.FullWidth" Class="my-4" />
                  <MudPaper Class="d-flex flex-row-reverse flex-grow-1 gap-4" Elevation="0">
                     <MudButton OnClick="SaveException" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Update" Disabled="btnSaveDisabled">
                        @if(processing == true) {
                           <MudProgressCircular Indeterminate="true" Color="Color.Success" /><MudText>...Processing</MudText>
                        }
                        else {
                           <MudText>Save</MudText>
                        }
                     </MudButton>
                     <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancel</MudButton>
                  </MudPaper>
               </MudForm>
            </ChildContent>
            
         </MudExpansionPanel>
      </MudExpansionPanels>
      
      <MudTable ServerData="@(new Func<TableState, Task<TableData<ExceptionDTO>>>(ServerReload))" Dense="true"
                Hover="true" @ref="table" Elevation="4" FixedHeader="true" FixedFooter="true" Bordered="false" Breakpoint="Breakpoint.Sm" Class="cursor-pointer" T="ExceptionDTO">
         <ToolBarContent>
            <MudText Typo="Typo.h6">Daftar Ketidakhadiran</MudText>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
         </ToolBarContent>
         <HeaderContent>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="id_field" T="ExceptionDTO">ID</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="nik_field" T="ExceptionDTO">NIK</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="name_field" T="ExceptionDTO">Nama</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="keterangan_field" T="ExceptionDTO">Keterangan</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="detail_field" T="ExceptionDTO">Detail</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="dari_field" T="ExceptionDTO">Dari</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="sampai_field" T="ExceptionDTO">Sampai</MudTableSortLabel></MudTh>
            @* <MudTh Class="pa-2 mud-theme-info"></MudTh> *@

         </HeaderContent>
         <RowTemplate>
            <MudTd Class="pa-2" DataLabel="ID">@context.Id</MudTd>
            <MudTd Class="pa-1" DataLabel="NIK">@context.NIK</MudTd>
            <MudTd Class="pa-1" DataLabel="Nama">@context.Nama</MudTd>
            <MudTd Class="pa-1" DataLabel="Keterangan">@context.ExceptionName</MudTd>
            <MudTd Class="pa-1" DataLabel="Detail">@context.Detail</MudTd>
            <MudTd Class="pa-1" DataLabel="Dari">@context.StartDate!.Value.ToString("dd-MM-yyyy")</MudTd>
            <MudTd Class="pa-1" DataLabel="Sampai">@context.EndDate!.Value.ToString("dd-MM-yyyy")</MudTd>
@*             <MudTd Class="pa-1">
               <MudGrid>
                  <MudItem xs="6" sm="3">
                     <MudIconButton Size="Size.Small" Title="Edit Data" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="((e) =>EditException(context))"></MudIconButton>
                  </MudItem>
                  <MudItem xs="6" sm="3">
                     <MudIconButton Size="Size.Small" Title="Hapus Data" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="((e) => DeleteException(context.Id))"></MudIconButton>
                  </MudItem>
               </MudGrid>
            </MudTd> *@
            
         </RowTemplate>
         <NoRecordsContent>
            <MudText>No matching records found</MudText>
         </NoRecordsContent>
         <LoadingContent>
            <MudText>Loading...</MudText>
         </LoadingContent>
         <PagerContent>
            <MudTablePager />
         </PagerContent>
      </MudTable>
	</MudCardContent>
</MudCard>


