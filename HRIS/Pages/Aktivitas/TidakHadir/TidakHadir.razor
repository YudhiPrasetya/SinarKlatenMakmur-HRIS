   private async Task<TableData<ExceptionDTO>> ServerReload(TableState state) {
      IEnumerable<ExceptionDTO> data = await exceptionService!.GetListExceptionsAsync();
      await Task.Delay(300);
      data = data.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.Nama.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if ($"{element.NIK} {element.Nama} {element.ExceptionName} {element.Detail}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = data.Count();
      switch (state.SortLabel) {
         case "id_field":
         data = data.OrderByDirection(state.SortDirection, o => o.Id);
         break;

         case "nik_field":
         data = data.OrderByDirection(state.SortDirection, o => o.NIK);
         break;

         case "name_field":
         data = data.OrderByDirection(state.SortDirection, o => o.Nama);
         break;

         case "keterangan_field":
         data = data.OrderByDirection(state.SortDirection, o => o.ExceptionName);
         break;

         case "detail_field":
         data = data.OrderByDirection(state.SortDirection, o => o.Detail);
         break;

         case "dari_field":
         data = data.OrderByDirection(state.SortDirection, o => o.StartDate);
         break;

         case "sampai_field":
         data = data.OrderByDirection(state.SortDirection, o => o.EndDate);
         break;
      }

      pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<ExceptionDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   private void OnSearch(string text) {
      searchString = text;
      table!.ReloadServerData();
   }

   async Task CariKaryawan() {
      var parameters = new DialogParameters<SearchEmployeeModal>();
      parameters.Add("ModalLabel", "Cari Data Karyawan");
      parameters.Add("EmployeeDTOS", Employees);
      //parameters.Add("GroupDTOS", Groups);
      var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };
      var dialog = await DialogService.ShowAsync<SearchEmployeeModal>("Data Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         Console.WriteLine(result.Data);
         EmployeeDTO? empDTO = new EmployeeDTO();
         empDTO = result.Data as EmployeeDTO;
         exceptionDTO.GrupKerja = empDTO!.GroupName;
         exceptionDTO.NIK = empDTO.NIK;
         exceptionDTO.Nama = empDTO.Name;
         //IdEmployee.Value = empDTO.EmployeeId;
         //NIK.Value = empDTO.NIK;
         //Nama.Value = empDTO.Name;
      }
   }

   private async Task<IEnumerable<ExceptionTypeDTO>> Search(string val) {
      await Task.Delay(5);
      if (string.IsNullOrEmpty(val)) return ExceptionTypeDTOS;
      return ExceptionTypeDTOS.Where(x => x.ExceptionName.Contains(val, StringComparison.InvariantCultureIgnoreCase));
      //return await exceptionTypeService.GetListExceptionTypeByValAsync(val);
   }

   private async void SaveException(){
      processing = true;
      btnSaveDisabled = true;

      string[] arrExpType = Exp.Text.Split("-");
      exceptionDTO.Id = Id!.Value;
      exceptionDTO.NIK = NIK!.Value;
      exceptionDTO.Nama = Nama!.Value;
      // exceptionDTO.IdException = int.Parse(arrExpType[0]);
      exceptionDTO.ExceptionName = arrExpType[1];
      exceptionDTO.Detail = Keterangan!.Value;
      exceptionDTO.StartDate = Durasi!.DateRange.Start!.Value;
      exceptionDTO.EndDate = Durasi.DateRange.End!.Value;
      exceptionDTO.CreatedAt = DateTime.Now;
      exceptionDTO.CreatedBy = 1;
      exceptionDTO.UpdatedAt = DateTime.Now;
      exceptionDTO.UpdatedBy = 1;
      if(Mode == "Add"){
         await exceptionService!.AddExceptionAsync(exceptionDTO);

         var diffDay = Durasi.DateRange.End.Value.Date - Durasi.DateRange.Start.Value.Date;
         int days = diffDay.Days;

         for(int x = 0; x <= days; x++) {
            // KehadiranDTO kehadiranDTO = new();
            // kehadiranDTO.GrupKerja = exceptionDTO.GrupKerja;
            // kehadiranDTO.NIK = exceptionDTO.NIK;
            // kehadiranDTO.Nama = exceptionDTO.Nama;
            // kehadiranDTO.Tanggal = Durasi.DateRange.Start.Value.Date.AddDays(x);
            // kehadiranDTO.Keterangan = arrExpType[1];
            // kehadiranDTOs.Add(kehadiranDTO);
            // Console.WriteLine($"KehadiranDTO: {kehadiranDTO.NIK}, {kehadiranDTO.GrupKerja}, {kehadiranDTO.Nama}, {kehadiranDTO.Tanggal}, {kehadiranDTO.Keterangan}");

            string tanggal = Durasi.DateRange.Start.Value.Date.AddDays(x).ToString("yyyy-MM-dd");
            JadwalKehadiranDTO? jadwalKehadiranDTO = await jadwalKehadiranService!.GetByNIKAndDate(exceptionDTO.NIK, tanggal);
            jadwalKehadiranDTO!.Keterangan = exceptionDTO.ExceptionName;
            jadwalKehadiranDTO!.LockedMasuk = true;
            jadwalKehadiranDTO!.Up = true;
            jadwalKehadiranDTOs.Add(jadwalKehadiranDTO);

            GajiDanTunjanganDTO? gajiDanTunjanganDTO = await gajiDanTunjanganService!.GetByNIK(exceptionDTO.NIK);
            decimal upahHarian = Math.Round((decimal)gajiDanTunjanganDTO!.Upah / 21, 2);
            PayrollDTO payrollDTO = new PayrollDTO
            {
               NIK = gajiDanTunjanganDTO!.NIK,
               GroupName = gajiDanTunjanganDTO!.GrupKerja,
               EmployeeName = gajiDanTunjanganDTO!.NamaKaryawan,
               IdEmployee = (int)gajiDanTunjanganDTO.EmployeeId!,
               DepartmentName = gajiDanTunjanganDTO.DepartmentName!,
               Bulan = Durasi.DateRange.End.Value.Month,
               Tahun = Durasi.DateRange.End.Value.Year,
               TotalMasuk = 1,
               Upah = gajiDanTunjanganDTO.Upah,
               Gaji = upahHarian,
               CreatedBy = 1,
               UpdatedBy = 1,
               UpdatedAt = DateTime.Today,
               CreatedAt = DateTime.Today,
            };
            payrollDTOs.Add(payrollDTO);

         }
         // await kehadiranService.TambahIjin(kehadiranDTOs);
         // await kehadiranService.TambahIjin(jadwalKehadiranDTOs);
         await jadwalKehadiranService!.UpdateJadwalKehadiranRange(jadwalKehadiranDTOs);
         await payrollService!.PostPayrollRange(payrollDTOs);

      }else{
         await exceptionService!.UpdateExceptionAsync(exceptionDTO);
         isOpen = false;
         Mode = "Add";
         formCaption = "Tambah Data Ketidakhadiran";
      }

      // StateHasChanged();
      processing = false;
      btnSaveDisabled = false;

      await table!.ReloadServerData();
      Snackbar.Add("Data ketidakhadiran berhasil disimpan di database!", Severity.Success, config => { config.HideTransitionDuration = 100; });
      await form!.ResetAsync();

      //Console.WriteLine(exception.Value);
   }

   private void Cancel() {
      form!.ResetAsync();
      isEdit=false;
      Mode = "Add";
      TitlePanelColor = Color.Tertiary;
      formCaption = "Tambah Data Ketidakhadiran";
   }

