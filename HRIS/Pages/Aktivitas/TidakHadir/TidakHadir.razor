   async Task DeleteException(int Id) {
      //var dialog = new DialogService();
      var rst = await DialogService.ShowMessageBox("Konfirmasi","Yakin akan menghapus?", "Ya","Tidak");
      if (rst == true) {
         await exceptionService!.DeleteExceptionAsync(Id);
         await table!.ReloadServerData();
         Snackbar.Add("Data ketidakhadiran berhasil dihapus dari database!", Severity.Success, config => { config.HideTransitionDuration = 100; });
