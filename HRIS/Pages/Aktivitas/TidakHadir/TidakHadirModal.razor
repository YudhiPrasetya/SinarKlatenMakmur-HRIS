@using HRIS.Contracts;
@using HRIS.Pages.SharedModal;
@using SKM.Shared.Dtos;
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<MudDialog>
   <TitleContent>
      <MudText Typo="Typo.h6">
         @ModalLabel
      </MudText>
   </TitleContent>
   <DialogContent>
      <MudProgressLinear ></MudProgressLinear>
      <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
         <MudGrid>
            <MudItem xs="2">
               <MudTextField @ref="Id" T="int" Label="Id" Required="true" @bind-Value="@exceptionDTO.Id" Disabled="true" />
            </MudItem>
         </MudGrid>

         <MudPaper Class="d-flex justify-space-between flex-grow-1 gap-2" Elevation="0">
@*             <MudTextField Class="d-inline" T="int" Label="ID" @ref="IdEmployee" Disabled="true" @bind-Value="@exceptionDTO.IdEmployee" ></MudTextField> *@
            <MudTextField @ref="NIK" Class="d-inline" T="string" Label="NIK" Disabled="true" @bind-Value="@exceptionDTO.NIK" Required="true" />
            <MudTextField @ref="Nama" Class="d-inline" T="string" Label="Nama" Disabled="true" @bind-Value="@exceptionDTO.Nama" Required="true" />
            <MudIconButton Class="d-inline" Icon="@Icons.Material.Filled.Search" Color="Color.Tertiary" OnClick="CariKaryawan" />
         </MudPaper>

         <MudGrid>
            <MudItem xs="8">
               @*<MudSelect @ref="IdException" @bind-Value="@exceptionDTO.IdException" @bind-Text="exceptionDTO.ExceptionName" Required="true" RequiredError="Alasan tidak hadir harus diisi!" Label="Alasan tidak hadir">
                  @foreach (var exceptionTypeDTO in ExceptionTypeDTOS) {
                     <MudSelectItem T="int" Value="exceptionTypeDTO.Id" >@exceptionTypeDTO.ExceptionName</MudSelectItem>
                  }
               </MudSelect>*@

               <MudAutocomplete @ref="Exp" T="ExceptionTypeDTO" Label="Keterangan" @bind-Value="exceptionTypeDTO" SearchFunc="@Search" ToStringFunc="@(e => $"{e.Id.ToString()}-{e.ExceptionName}")" CoerceText="@coerceText" CoerceValue="@coerceValue">
                  <BeforeItemsTemplate>
                     <MudText Color="Color.Primary" Class="px-4 py-1">--Pilih Alasan--</MudText>
                  </BeforeItemsTemplate>
               </MudAutocomplete>

            </MudItem>
         </MudGrid>
         <MudGrid>
            <MudItem xs="10">
               <MudTextField @ref="Keterangan" Label="Keterangan" @bind-Value="@exceptionDTO.Detail"></MudTextField>
            </MudItem>
         </MudGrid>

         <MudGrid>
            <MudItem xs="6">
               <MudDateRangePicker @ref="Durasi" Placeholder="Date Range" Label="Durasi tidak hadir" PlaceholderStart="Dari" PlaceholderEnd="Sampai" />
            </MudItem>
         </MudGrid>
      </MudForm>
   </DialogContent>
   <DialogActions>
      <MudPaper Class="d-flex flex-row-reverse flex-grow-1 gap-4" Elevation="0">
         <MudButton OnClick="SaveException" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Update">Save</MudButton>
         <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancel</MudButton>
      </MudPaper>
   </DialogActions>
</MudDialog>

@code {
