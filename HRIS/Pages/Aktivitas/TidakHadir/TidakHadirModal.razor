   private async Task<IEnumerable<ExceptionTypeDTO>> Search(string val) {
      await Task.Delay(5);
      if (string.IsNullOrEmpty(val)) return ExceptionTypeDTOS;
      return ExceptionTypeDTOS.Where(x => x.ExceptionName.Contains(val, StringComparison.InvariantCultureIgnoreCase));
