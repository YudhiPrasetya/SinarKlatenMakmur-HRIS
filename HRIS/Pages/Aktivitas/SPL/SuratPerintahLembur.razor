   async Task TambahSPL() {
      var parameters = new DialogParameters {
         ["dataGaji"] = gajiDTOS,
         ["dataGroup"] = groupDTOs,
         ["Mode"] = "Tambah",
      };

      var options = new DialogOptions() { CloseButton = false, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };

      var dialog = await DialogService.ShowAsync<FormSPLDialog>($"{Mode} Data SPL Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         await splTable!.ReloadServerData();
      }
   }

   async Task EditSPL(SuratPerintahLemburDTO selectedSPL) {
      Mode = "Edit";
      TitlePanelColor = Color.Warning;
      formCaption = "Edit Data SPL";
      splDTO.Id = selectedSPL.Id;
      splDTO.Description = selectedSPL.Description;
      splDTO.OTDate = selectedSPL.OTDate;
      splDTO.OTType = selectedSPL.OTType;
      splDTO.OT1 = selectedSPL.OT1;
      splDTO.OT2 = selectedSPL.OT2;
      splDTO.OTBreak = selectedSPL.OTBreak;
      splDTO.OTTotal = selectedSPL.OTTotal;
      splDTO.Style = selectedSPL.Style;
      List<SuratPerintahLemburDTO> spls = await splService!.GetSPLByGroupId_OTDateAsync(selectedSPL.GroupId!.Value, DateConversions.DateTimeToInt(selectedSPL.OTDate));
      List<GajiDanTunjanganDTO> gajiDTOs = new List<GajiDanTunjanganDTO>();
      foreach(var spl in spls) {
         gajiDTOs.Add(new GajiDanTunjanganDTO {
            GroupId = spl.GroupId,
            GrupKerja = spl.GroupName!,
            DepartmentId = spl.DepartmentId,
            DepartmentName = spl.DepartmentName,
            NIK = spl.NIK!,
            NamaKaryawan = spl.EmployeeName!
         });
      }
      gajiDTOS = gajiDTOs;
      StateHasChanged();
      // departmentDTO.DepartmentID = selectedDepartment.DepartmentID;
      // departmentDTO.DepartmentName = selectedDepartment.DepartmentName;
      // departmentDTO.DepartmentDescription = selectedDepartment.DepartmentDescription;
      // departmentDTO.IsActive = selectedDepartment.IsActive;
      // departmentDTO.Budget = selectedDepartment.Budget;
      // departmentDTO.UpdatedAt = DateTime.Now;
      // departmentDTO.UpdatedBy = 1;
      isOpen = true;

   }

