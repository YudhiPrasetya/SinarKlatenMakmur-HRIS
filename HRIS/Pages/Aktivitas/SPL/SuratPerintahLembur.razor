   private async Task<TableData<SuratPerintahLemburDTO>> ServerReload(TableState state) {
      var data = await splService!.GetListSPLsAsync();
      await Task.Delay(50);
      data = data.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;

         if (element.Id.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.GroupName!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.EmployeeName!.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.NIK!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.OT1!.Value.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.OT2!.Value.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.OTTotal!.Value.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if (element.Description!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if ($"{element.Id.ToString()} {element.GroupName} {element.EmployeeName} {element.NIK} {element.OT1.ToString()} {element.OT2.ToString()} {element.OTTotal.ToString()} {element.Description}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = data.Count();
      switch (state.SortLabel) {
         case "id_field":
         data = data.OrderByDirection(state.SortDirection, o => o.Id);
         break;
         case "grup_field":
         data = data.OrderByDirection(state.SortDirection, o => o.GroupName);
         break;
         case "nama_field":
         data = data.OrderByDirection(state.SortDirection, o => o.EmployeeName);
         break;
         case "nik_field":
         data = data.OrderByDirection(state.SortDirection, o => o.NIK);
         break;
         case "ot1_field":
         data = data.OrderByDirection(state.SortDirection, o => o.OT1);
         break;
         case "ot2_field":
         data = data.OrderByDirection(state.SortDirection, o => o.OT2);
         break;
         case "totalOT_field":
         data = data.OrderByDirection(state.SortDirection, o => o.OTTotal);
         break;
         case "keterangan_field":
         data = data.OrderByDirection(state.SortDirection, o => o.Description);
         break;
      }

      pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<SuratPerintahLemburDTO>() { TotalItems = totalItems, Items = pagedData };
   }

