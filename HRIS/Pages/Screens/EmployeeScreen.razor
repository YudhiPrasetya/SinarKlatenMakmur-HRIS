@layout EmptyLayout
@page "/display"

@inject HttpClient httpClient;
@using ApexCharts
@using Microsoft.AspNetCore.SignalR.Client;
@using Newtonsoft.Json;
@using SKM.Shared.Dtos;
@using SKM.Shared.Helpers;
@using System.Globalization;


<MudGrid>
   <MudItem xs="8">
         <MudText Class="d-flex align-center" Typo="Typo.h5" Style="@($"color:{Colors.Indigo.Darken3};")"><strong>Selamat Datang di Dashboard Globalindo Intimates II</strong></MudText>
   </MudItem>

   <MudItem xs="4">
      <MudCard Elevation="3" Class="mud-theme-primary">
         <MudCardContent>
            <div class="d-flex justify-space-around gap-4">
               <div class="d-flex flex-column">
                  <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Surface">Masuk Tepat Waktu</MudText>
                  <MudText Class="d-flex justify-center" Typo="Typo.subtitle1" Color="MudBlazor.Color.Success"><strong>@tepatWaktu</strong></MudText>
               </div>
               <div class="d-flex flex-column">
                  <MudText Typo="Typo.subtitle2">Terlambat</MudText>
                  <MudText Class="d-flex justify-center" Typo="Typo.subtitle1" Color="MudBlazor.Color.Warning"><strong>@terlambat</strong></MudText>
               </div>
               <div class="d-flex flex-column">
                  <MudText Typo="Typo.subtitle2">Total</MudText>
                  <MudText Class="d-flex justify-center" Typo="Typo.subtitle1" Color="MudBlazor.Color.Error"><strong>@total</strong></MudText>
               </div>

            </div>
         </MudCardContent>
      </MudCard>
   </MudItem>
</MudGrid>

<MudGrid Spacing="2">
   <MudItem xs="4">
      @* Total Karyawan Aktif *@
      <MudCard Elevation="3" Class="mb-2">
         <MudCardContent>
            <div class="d-flex flex-grow-1 gap-4">
               <MudText Class="flex-grow-1" Style="@($"color:{Colors.Indigo.Darken3};")" Typo="Typo.h6">Total Karyawan Aktif</MudText>
               <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")"><MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="MudBlazor.Size.Small" Style="@($"color:{Colors.Indigo.Darken3};")" />@total</MudText>
            </div>
            <div>
               @if (komposisiKaryawans != null) {
                  <ApexChart TItem="KomposisiKaryawan" Title="Komposisi Karyawan" @ref="chart" Options="options">
                     <ApexPointSeries TItem="KomposisiKaryawan"
                                      Items="komposisiKaryawans"
                                      SeriesType="SeriesType.Bar"
                                      Name="Komposisi Karyawan"
                                      XValue="@(e => e.Gender)"
                                      YAggregate="@(e => e.Sum(e => e.Jumlah))"
                                      Color="#005ba3"
                                      PointColor="e => GetColor(e)" ShowDataLabels />
                   </ApexChart>
               }

            </div>
         </MudCardContent>
      </MudCard>

      @* Karyawan Tidak Masuk *@
      <MudCard Elevation="3">
         <MudCardContent>
            <div class="d-flex flex-grow-1 gap-4 pb-2">
               <MudText Class="flex-grow-1" Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">Karyawan Tidak Masuk</MudText>
               <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">@DateTime.Now.Date.ToString("dd-MMM")</MudText>
            </div>
         </MudCardContent>
      </MudCard>
   </MudItem>

   <MudItem xs="8">
      @* Karyawan Terlambat *@
      <MudCard Elevation="3" Class="mb-2">
         <MudCardContent>
            <div class="d-flex flex-grow-1 gap-4 pb-2">
               <MudBadge Icon="@Icons.Material.Filled.ThumbDown" Color="MudBlazor.Color.Error" Overlap="true" Bordered="true" Class="flex-grow-1 mx-6 my-4">
                  <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">Karyawan Terlambat</MudText>
               </MudBadge>

               <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">@DateTime.Now.Date.ToString("dd-MMM")</MudText>
            </div>
            <MudSimpleTable Dense="true">
               <thead>
                  <tr>
                     <th>Nama</th>
                     <th>Jadwal</th>
                     <th>Jam Masuk</th>
                     <th>Grup</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach (var e in terlambatDTOs) {
                     <tr>
                        <td>
                           <MudText Color="MudBlazor.Color.Error" Typo="Typo.subtitle2">@e.Nama</MudText>
                        </td>
                        <td>
                           <MudText Color="MudBlazor.Color.Error" Typo="Typo.subtitle2">@e.JadwalMasuk?.ToString(@"hh\:mm\:ss")</MudText>
                        </td>
                        <td>
                           <MudText Class="flex-grow-1" Color="MudBlazor.Color.Error" Typo="Typo.subtitle2">@e.JamMasuk.Value.ToString(@"hh\:mm\:ss")</MudText>
                        </td>
                        <td>
                           <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Error">@e.GrupKerja</MudText>
                        </td>
                     </tr>
                  }
               </tbody>
            </MudSimpleTable>
         </MudCardContent>
      </MudCard>

      @* Karyawan Rajin *@
      <MudCard Elevation="3" Class="mb-2">
         <MudCardContent>
            <div class="d-flex flex-grow-1 gap-4 pb-2">
               <MudBadge Icon="@Icons.Material.Filled.ThumbUp" Color="MudBlazor.Color.Success" Overlap="true" Bordered="true" Class="flex-grow-1 mx-6 my-4">
                  <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">Karyawan Rajin</MudText>
               </MudBadge>
               <MudText Typo="Typo.h6" Style="@($"color:{Colors.Indigo.Darken3};")">@DateTime.Now.Date.ToString("dd-MMM")</MudText>
            </div>
            <MudSimpleTable Dense="true">
               <thead>
                  <tr>
                     <th>Nama</th>
                     <th>Jadwal</th>
                     <th>Jam Masuk</th>
                     <th>Grup</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach (var k in kehadiranDTOs) {
                     <tr>
                        <td>
                           <MudText Color="MudBlazor.Color.Success" Typo="Typo.subtitle2">@k.Nama</MudText>
                        </td>
                        <td>
                           <MudText Color="MudBlazor.Color.Success" Typo="Typo.subtitle2">@k.JadwalMasuk?.ToString(@"hh\:mm\:ss")</MudText>
                        </td>
                        <td>
                           <MudText Color="MudBlazor.Color.Success" Typo="Typo.subtitle2">
                              @k.JamMasuk?.ToString(@"hh\:mm\:ss")
                           </MudText>
                        </td>
                        <td>
                           <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Success">@k.GrupKerja</MudText>
                        </td>
                     </tr>
                  }
               </tbody>
            </MudSimpleTable>
         </MudCardContent>
      </MudCard>
   </MudItem>

</MudGrid>



