   private async void SaveDepartment() {

      departmentDTO.DepartmentID = Id.Value;
      departmentDTO.DepartmentName = DepartmentName.Value;
      departmentDTO.DepartmentDescription = DepartmentDescription.Value;
      departmentDTO.Budget = Budget.Value;
      departmentDTO.IsActive = IsActive.Checked;
      departmentDTO.CreatedAt = DateTime.Now;
      departmentDTO.CreatedBy = 1;
      departmentDTO.UpdatedAt = DateTime.Now;
      departmentDTO.UpdatedBy = 1;
      if(Mode == "Add") {
         await departmentService.AddDepartmentAsync(departmentDTO);
      }
      else {
         var depDTO = await departmentService.UpdateDepartmentAsync(departmentDTO);
         // bool departmentOfferSend = await departmentService.SendDepartmentOffer(depDTO);
         // Console.WriteLine(departmentOfferSend);
         isOpen = false;
         Mode="Add";
         formCaption = "Tambah Data Departemen";
      }

      // departmentDTOs.Clear();
      // departmentTable.Items = null;
      // departmentDTOs = await departmentService.GetListDepartmentsAsync();
      // departmentTable.Items = departmentDTOs;
      // StateHasChanged();
      // await FillDepartments();
      Snackbar.Add("Data departemen berhasil disimpan di database!", Severity.Success, config => {
         config.HideTransitionDuration = 100;
      });

      // Task.Delay(100);
      await departmentTable.ReloadServerData();
      await departmentForm.ResetAsync();
      // GetDepartments();
   }

   async Task DeleteDepartment(int Id) {
      bool? deleteConfirmation = await DialogService.ShowMessageBox("Konfirmasi", "Yakin akan menghapus?", "Ya", "Tidak");
      if (deleteConfirmation == true) {
         var response = await departmentService.DeleteDepartmentAsync(Id);
         if(response != null) {
            await departmentTable.ReloadServerData();
            Snackbar.Add("Data departemen berhasil dihapus.", Severity.Info, config => {
               config.HideTransitionDuration = 100;
            });
         }

      }
   }

