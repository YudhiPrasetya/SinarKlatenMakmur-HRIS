<style>
   .backdrops-style {
      backdrop-filter: blur(5px);
   }
</style>

<MudCard Class="mt-5" Elevation="1">
   <MudCardHeader>
      <CardHeaderContent>
         <MudText Typo="Typo.h6">Data Departemen</MudText>
      </CardHeaderContent>
      <CardHeaderActions>
         @*<MudIconButton Icon="@Icons.Material.Filled.Add" Title="Tambah Data" Color="Color.Success"></MudIconButton>*@
         @*			<MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Label="Tambah Data" />*@

         @*         <MudButton Color="Color.Tertiary" OnClick="@((e) => addException())" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">Tambah Data</MudButton>*@
      </CardHeaderActions>
   </MudCardHeader>
   <MudCardContent>
      <MudExpansionPanels Elevation="3">
         <MudExpansionPanel @bind-IsExpanded="isOpen" HideIcon="true">
            <TitleContent>
               <div class="d-flex">
                  <MudText Color="@TitlePanelColor"><strong>@formCaption</strong></MudText>
                  <MudIcon Icon="@(isOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" class="ml-auto"></MudIcon>
               </div>
            </TitleContent>
            <ChildContent>
               <MudForm @ref="departmentForm" @bind-IsValid="@success" @bind-Errors="@errors">
                  <MudGrid>
                     <MudItem xs="1">
                        <MudTextField @ref="Id" T="int" Label="Id" Required="true" Disabled="true" @bind-Value="@departmentDTO.DepartmentID"></MudTextField>
                     </MudItem>
                     <MudItem xs=4>
                        <MudTextField @ref="DepartmentName" Label="Nama" Required="true" @bind-Value="@departmentDTO.DepartmentName"></MudTextField>
                     </MudItem>
                     <MudItem xs=4>
                        <MudTextField @ref="DepartmentDescription" Label="Deskripsi" Required="false" @bind-Value="@departmentDTO.DepartmentDescription"></MudTextField>
                     </MudItem>
                     <MudItem xs=4>
                        <MudNumericField @ref="Budget" Label="Budget" Required="false" @bind-Value="@departmentDTO.Budget"></MudNumericField>
                     </MudItem>
                     <MudItem xs="2">
                        <MudSwitch @ref="IsActive" @bind-Checked="@departmentDTO.IsActive" Color="Color.Success" Label="Aktif" LabelPosition="MudBlazor.LabelPosition.End"></MudSwitch>
@*                         <MudCheckBox  @bind-Checked="@departmentDTO.IsActive" Label="Aktif" Color="Color.Success" LabelPosition="MudBlazor.LabelPosition.Start"></MudCheckBox> *@
                     </MudItem>
                  </MudGrid>
                  <MudDivider DividerType="DividerType.Inset" Class="my-4"></MudDivider>
                  <MudPaper Class="d-flex flex-row-reverse flex-grow-1 gap-4" Elevation="0">
                     <MudButton OnClick="SaveDepartment" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Update">Save</MudButton>
                     <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancel</MudButton>
                  </MudPaper>
               </MudForm>
            </ChildContent>

         </MudExpansionPanel>
      </MudExpansionPanels>

      <MudTable ServerData="@(new Func<TableState, Task<TableData<DepartmentDTO>>>(ServerReload))" Dense="true" T="DepartmentDTO" Hover="true" @ref="departmentTable" Elevation="4" FixedHeader="true" FixedFooter="true" Bordered="false" Breakpoint="Breakpoint.Sm" Class="cursor-pointer">
         <ToolBarContent>
            <MudText Typo="Typo.h6">Daftar Departemen</MudText>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
         </ToolBarContent>
         <HeaderContent>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="id_field" T="DepartmentDTO">ID</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="name_field" T="DepartmentDTO">Nama</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="desc_field" T="DepartmentDTO">Deskripsi</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"><MudTableSortLabel SortLabel="budget_field" T="DepartmentDTO">Budget</MudTableSortLabel></MudTh>
            <MudTh Class="bg-opacity-25 mud-theme-info"><MudTableSortLabel SortLabel="active_field" T="DepartmentDTO">Aktif</MudTableSortLabel></MudTh>
            <MudTh Class="pa-2 mud-theme-info"></MudTh>
         </HeaderContent>
         <RowTemplate>
            <MudTd Class="pa-2" DataLabel="ID">@context.DepartmentID</MudTd>
            <MudTd Class="pa-1" DataLabel="Nama">@context.DepartmentName</MudTd>
            <MudTd Class="pa-1" DataLabel="Deskripsi">@context.DepartmentDescription</MudTd>
            <MudTd Class="pa-1" DataLabel="Budget">@context.Budget</MudTd>
            <MudTd Class="pa-1" DataLabel="Aktif"><MudSwitch Label="Aktif" Color="Color.Success" @bind-Checked="context.IsActive" ReadOnly="true" LabelPosition="MudBlazor.LabelPosition.End"></MudSwitch></MudTd>
            <MudTd Class="pa-1">
               <MudGrid>
                  <MudItem xs="6" sm="3">
                     <MudIconButton Size="Size.Small" Title="Edit Data" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="((e) =>EditDepartment(context))"></MudIconButton>
                  </MudItem>
                  <MudItem xs="6" sm="3">
                     <MudIconButton Size="Size.Small" Title="Hapus Data" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="((e) => DeleteDepartment(context.DepartmentID))"></MudIconButton>
                  </MudItem>
               </MudGrid>
            </MudTd>

         </RowTemplate>
         <NoRecordsContent>
            <MudText>No matching records found</MudText>
         </NoRecordsContent>
         <LoadingContent>
            <MudText>Loading...</MudText>
         </LoadingContent>
         <PagerContent>
            <MudTablePager />
         </PagerContent>
      </MudTable>
   </MudCardContent>
</MudCard>

