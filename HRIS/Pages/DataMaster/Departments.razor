   private void OnSearch(string text) {
      searchString = text;
      departmentTable.ReloadServerData();
   }

   private async Task<TableData<DepartmentDTO>> ServerReload(TableState state) {
      try {
         var tokenDTO = await tokenService.GetToken();
         if(tokenDTO.Token != null) {
            httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokenDTO.Token);

            // try {
               IEnumerable<DepartmentDTO> data = await departmentService.GetListDepartmentsAsync();
               await Task.Delay(100);
               data = data.Where(element => {
                  if (string.IsNullOrWhiteSpace(searchString))
                     return true;
                  if (element.DepartmentName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
                     return true;
                  if (element.DepartmentDescription.Contains(searchString, StringComparison.OrdinalIgnoreCase))
                     return true;
                  if ($"{element.DepartmentName} {element.DepartmentDescription}".Contains(searchString))
                     return true;
                  return false;
               }).ToArray();
               totalItems = data.Count();
               switch (state.SortLabel) {
                  case "id_field":
                  data = data.OrderByDirection(state.SortDirection, o => o.DepartmentID);
                  break;

                  case "name_field":
                  data = data.OrderByDirection(state.SortDirection, o => o.DepartmentName);
                  break;

                  case "desc_field":
                  data = data.OrderByDirection(state.SortDirection, o => o.DepartmentDescription);
                  break;

                  case "active_field":
                  data = data.OrderByDirection(state.SortDirection, o => o.IsActive);
                  break;

               }

               pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
               return new TableData<DepartmentDTO>() { TotalItems = totalItems, Items = pagedData };
            // }
            // catch (Exception e) {
            //    await MainLayout.HandleException(e);
            // }


         }
         else {
            // await authenticationHttpClientService.LogoutUser();

            // var dialogOptions = new DialogOptions { ClassBackground = "backdrops-style", DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Small, Position = DialogPosition.Center };
            // var dialogParameters = new DialogParameters<LoginFormDialog>();
            // dialogParameters.Add(f => f.Open, true);
            // await DialogService.ShowAsync<LoginFormDialog>("Login Form", dialogParameters, dialogOptions);

            // NavigationManager.NavigateTo("/auth/login");


         }
         return default;
      }
      catch (Exception e) {
         Console.WriteLine(e.Message);
         return null;
      }


   }

   private bool FilterFunc(DepartmentDTO departmentDTO) {
      if (string.IsNullOrWhiteSpace(searchString))
         return true;
      if (departmentDTO.DepartmentName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
         return true;
      if (departmentDTO.DepartmentDescription.Contains(searchString, StringComparison.OrdinalIgnoreCase))
         return true;
      if ($"{departmentDTO.DepartmentName} {departmentDTO.DepartmentDescription}".Contains(searchString))
         return true;
      return false;
   }

   private void Cancel() {
      departmentForm.ResetAsync();
      isEdit = false;
      Mode = "Add";
      TitlePanelColor = Color.Tertiary;
      formCaption = "Tambah Data Departemen";
   }

   async Task EditDepartment(DepartmentDTO selectedDepartment) {
      Mode = "Edit";
      TitlePanelColor = Color.Warning;
      formCaption = "Edit Data Departemen";
      departmentDTO.DepartmentID = selectedDepartment.DepartmentID;
      departmentDTO.DepartmentName = selectedDepartment.DepartmentName;
      departmentDTO.DepartmentDescription = selectedDepartment.DepartmentDescription;
      departmentDTO.IsActive = selectedDepartment.IsActive;
      departmentDTO.Budget = selectedDepartment.Budget;
      departmentDTO.UpdatedAt = DateTime.Now;
      departmentDTO.UpdatedBy = 1;
      isOpen = true;

   }

   // private void OnIsActiveChange(bool b) {
