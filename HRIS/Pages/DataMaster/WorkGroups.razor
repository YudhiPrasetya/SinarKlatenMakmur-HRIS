   async Task DeleteWorkGroup(int Id) {
      bool? deleteConfirmation = await DialogService.ShowMessageBox("Konfirmasi", "Yakin akan menghapus?", "Ya", "Tidak");
      if (deleteConfirmation == true) {
         var response = await workGroupService.DeleteWorkGroupAsync(Id);
         if (response != null) {
            await workGroupTable.ReloadServerData();
            Snackbar.Add("Data kelompok kerja berhasil dihapus.", Severity.Info, config => {
               config.HideTransitionDuration = 100;
            });
         }

      }
