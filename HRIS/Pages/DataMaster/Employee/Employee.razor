   protected async override Task OnInitializedAsync() {
      // return base.OnInitializedAsync();
      Departments = await departmentService.GetListDepartmentsAsync();
      Positions = await positionService.GetListPositions();
      Groups = await groupService.GetListGroupsAsync();
      Employees = await employeeService.GetListEmployeesAsync();
   }

   private void OnSearch(string text) {
      searchString = text;
      employeeTable.ReloadServerData();
      StateHasChanged();
   }

   private async Task<IEnumerable<DepartmentDTO>> DepartmentSearch(string val) {
      await Task.Delay(5);
      if (string.IsNullOrEmpty(val)) return Departments;
      return Departments.Where(x => x.DepartmentName.Contains(val, StringComparison.InvariantCultureIgnoreCase));
      //return await exceptionTypeService.GetListExceptionTypeByValAsync(val);
   }

   private async Task<IEnumerable<PositionDTO>> PositionSearch(string val) {
      await Task.Delay(5);
      if (string.IsNullOrEmpty(val)) return Positions;
      return Positions.Where(
         p => p.PositionDesc.Contains(val, StringComparison.InvariantCultureIgnoreCase)
      );
      //return await exceptionTypeService.GetListExceptionTypeByValAsync(val);
   }

   private async Task<IEnumerable<GroupDTO>> GroupSearch(string val) {
      await Task.Delay(5);
      if (string.IsNullOrEmpty(val)) return Groups;
      return Groups.Where(
         g => g.GroupDesc.Contains(val, StringComparison.CurrentCultureIgnoreCase)
      );
      //return await exceptionTypeService.GetListExceptionTypeByValAsync(val);
   }

