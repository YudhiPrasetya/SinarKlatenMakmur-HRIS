      employeeDTO.ContractStartDate = ContractStartDate.Date.Value;
      employeeDTO.ContractEndDate = ContractEndDate.Date.Value;
      employeeDTO.MotherName = MotherName.Value;
      employeeDTO.PhoneNumber = PhoneNumber.Value;
      employeeDTO.CreatedAt = DateTime.Now;
      employeeDTO.CreatedBy = 1;
      employeeDTO.UpdatedAt = DateTime.Now;
      employeeDTO.UpdatedBy = 1;
      if (Mode == "Add") {
         await employeeService.AddEmployeeAsync(employeeDTO);
      }
      else {
         var empDTO = await employeeService.UpdateEmployeeAsync(employeeDTO);
         // bool departmentOfferSend = await departmentService.SendDepartmentOffer(depDTO);
         // Console.WriteLine(departmentOfferSend);
         isOpen = false;
         Mode = "Add";
         formCaption = "Tambah Data Karyawan";
      }

      // departmentDTOs.Clear();
      // departmentTable.Items = null;
      // departmentDTOs = await departmentService.GetListDepartmentsAsync();
      // departmentTable.Items = departmentDTOs;
      // StateHasChanged();
      // await FillDepartments();
      Snackbar.Add("Data Karyawan berhasil disimpan di database!", Severity.Success, config => {
         config.HideTransitionDuration = 100;
      });

      // Task.Delay(100);
      await employeeTable.ReloadServerData();
      await employeeForm.ResetAsync();
   }

   async Task DeleteEmployee(int Id) {
      bool? deleteConfirmation = await DialogService.ShowMessageBox("Konfirmasi", "Yakin akan menghapus?", "Ya", "Tidak");
      if (deleteConfirmation == true) {
         var response = await employeeService.DeleteEmployeeAsync(Id);
         if (response != null) {
            await employeeTable.ReloadServerData();
            Snackbar.Add("Data karyawan berhasil dihapus.", Severity.Info, config => {
               config.HideTransitionDuration = 100;
            });
         }

      }
   }

   async Task SearchDepartment() {
      var parameters = new DialogParameters<SearchDepartmentModal>();
      parameters.Add("ModalLabel", "Cari Data Departemen");
      parameters.Add("Departments", Departments);
      var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };
      var dialog = await DialogService.ShowAsync<SearchDepartmentModal>("Data Departemen", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         DepartmentDTO depDTO = new DepartmentDTO();
         depDTO = result.Data as DepartmentDTO;
         employeeDTO.DepartmentId = depDTO.DepartmentID;
         employeeDTO.DepartmentName = depDTO.DepartmentName;
      }
   }

