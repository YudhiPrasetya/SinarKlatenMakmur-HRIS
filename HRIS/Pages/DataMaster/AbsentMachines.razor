   private void OnSearch(string text) {
      searchString = text;
      mesinAbsenTable!.ReloadServerData();
   }

   private async Task<TableData<MesinAbsenDTO>> ServerReload(TableState state) {
      IEnumerable<MesinAbsenDTO> data = await mesinAbsenService!.GetListMesinAbsenAsync();
      await Task.Delay(100);
      data = data.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.DeviceDesc.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.DeviceIP.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if ($"{element.DeviceDesc} {element.DeviceIP}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = data.Count();
      switch (state.SortLabel) {
         case "id_field":
         data = data.OrderByDirection(state.SortDirection, o => o.DeviceID);
         break;

         case "desc_field":
         data = data.OrderByDirection(state.SortDirection, o => o.DeviceDesc);
         break;

         case "ip_field":
         data = data.OrderByDirection(state.SortDirection, o => o.DeviceIP);
         break;

         case "active_field":
         data = data.OrderByDirection(state.SortDirection, o => o.IsActive);
         break;

      }

      pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<MesinAbsenDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   private void Cancel() {
      mesinAbsenForm!.ResetAsync();
      isEdit = false;
      Mode = "Add";
      TitlePanelColor = Color.Tertiary;
      formCaption = "Tambah Data Mesin Absen";
   }

   void EditMesinAbsen(MesinAbsenDTO selectedMesinAbsen) {
      Mode = "Edit";
      TitlePanelColor = Color.Warning;
      formCaption = "Edit Data Mesin Absen";
      mesinAbsenDTO.DeviceID = selectedMesinAbsen.DeviceID;
      mesinAbsenDTO.DeviceDesc = selectedMesinAbsen.DeviceDesc;
      mesinAbsenDTO.DeviceIP = selectedMesinAbsen.DeviceIP;
      // mesinAbsenDTO.IsActive = selectedMesinAbsen.IsActive;
      mesinAbsenDTO.IsActive = IsActive!.Checked;
      mesinAbsenDTO.UpdatedAt = DateTime.Now;
      mesinAbsenDTO.UpdatedBy = 1;
      isOpen = true;

   }

   // private void OnIsActiveChange(bool b) {
   //    IsActive = b;
