   private async void SaveMesinAbsen() {
      mesinAbsenDTO.DeviceID = Id!.Value;
      mesinAbsenDTO.DeviceDesc = DeviceDesc!.Value;
      mesinAbsenDTO.DeviceIP = DeviceIP!.Value;
      mesinAbsenDTO.IsActive = IsActive!.Checked;
      mesinAbsenDTO.CreatedAt = DateTime.Now;
      mesinAbsenDTO.CreatedBy = 1;
      mesinAbsenDTO.UpdatedAt = DateTime.Now;
      mesinAbsenDTO.UpdatedBy = 1;
      if (Mode == "Add") {
         await mesinAbsenService!.AddMesinAbsenAsync(mesinAbsenDTO);
      }
      else {
         var depDTO = await mesinAbsenService!.UpdateMesinAbsenAsync(mesinAbsenDTO);
         // bool departmentOfferSend = await departmentService.SendDepartmentOffer(depDTO);
         // Console.WriteLine(departmentOfferSend);
         isOpen = false;
         Mode = "Add";
         formCaption = "Tambah Data Mesin Absen";
      }

      Snackbar.Add("Data mesin absen berhasil disimpan di database!", Severity.Success, config => {
         config.HideTransitionDuration = 100;
      });

      // Task.Delay(100);
      await mesinAbsenTable!.ReloadServerData();
      await mesinAbsenForm!.ResetAsync();
      // GetDepartments();
   }

   async Task DeleteMesinAbsen(int Id) {
      bool? deleteConfirmation = await DialogService.ShowMessageBox("Konfirmasi", "Yakin akan menghapus?", "Ya", "Tidak");
      if (deleteConfirmation == true) {
         var response = await mesinAbsenService!.DeleteMesinAbsenAsync(Id);
         if (response != null) {
            await mesinAbsenTable!.ReloadServerData();
            Snackbar.Add("Data mesin absen berhasil dihapus.", Severity.Info, config => {
               config.HideTransitionDuration = 100;
            });
         }

      }
   }

