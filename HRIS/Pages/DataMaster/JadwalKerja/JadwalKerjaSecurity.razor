</style>

<MudGrid Class="mb-6">
	<MudItem xs="3" sm="3">
		<MudSelect Label="Pilih Bulan" T="int" @bind-Value="bulan">
			<MudSelectItem Value="1">Januari</MudSelectItem>
			<MudSelectItem Value="2">Pebruari</MudSelectItem>
			<MudSelectItem Value="3">Maret</MudSelectItem>
			<MudSelectItem Value="4">April</MudSelectItem>
			<MudSelectItem Value="5">Mei</MudSelectItem>
			<MudSelectItem Value="6">Juni</MudSelectItem>
			<MudSelectItem Value="7">Juli</MudSelectItem>
			<MudSelectItem Value="8">Agustus</MudSelectItem>
			<MudSelectItem Value="9">September</MudSelectItem>
			<MudSelectItem Value="10">Oktber</MudSelectItem>
			<MudSelectItem Value="11">Nopember</MudSelectItem>
			<MudSelectItem Value="12">Desember</MudSelectItem>
		</MudSelect>
	</MudItem>
	<MudItem xs="3" sm="3">
		<MudSelect Label="Pilih Tahun" T="int" @bind-Value="tahun">
			<MudSelectItem Value="2023">2023</MudSelectItem>
			<MudSelectItem Value="2024">2024</MudSelectItem>
			<MudSelectItem Value="2025">2025</MudSelectItem>
			<MudSelectItem Value="2026">2026</MudSelectItem>
			<MudSelectItem Value="2027">2027</MudSelectItem>
			<MudSelectItem Value="2028">2028</MudSelectItem>
			<MudSelectItem Value="2029">2029</MudSelectItem>
			<MudSelectItem Value="2030">2030</MudSelectItem>
		</MudSelect>
	</MudItem>
	<MudItem xs="3" sm="3">
		<MudSelect Label="Pilih Grup kerja" T="string" @bind-Value="grupKerja">
			<MudSelectItem Value="@("SECURITY_PRIA")">Security Pria</MudSelectItem>
			<MudSelectItem Value="@("SECURITY_WANITA")">Security Wanita</MudSelectItem>
		</MudSelect>
	</MudItem>
	<MudItem xs="3" sm="3">
		<MudButton OnClick="proses" Color="Color.Info" Variant="Variant.Filled" Disabled="processing">
			@if (processing) {
				<MudProgressCircular Class="ms-n1" Size="Size.Small" Color="Color.Success" Indeterminate="true" />
				<MudText>Processing...</MudText>
			}else{
				<MudText>Proses</MudText>
			}
		</MudButton>
	</MudItem>
</MudGrid>

