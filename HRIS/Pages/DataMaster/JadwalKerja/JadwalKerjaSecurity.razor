<style type="text/css">
	.mud-table-head .header-centered th {
		text-align: center;
		font-size: 1.2em;
	}

	.mud-table-foot .bold-text .mud-table-cell {
		font-weight: 500;
	}
	.backdrops-style {
		backdrop-filter: blur(5px);
