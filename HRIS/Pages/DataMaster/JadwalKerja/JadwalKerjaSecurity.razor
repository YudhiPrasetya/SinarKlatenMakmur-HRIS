		// var tgl = new DateTime(Tahun, Bulan, Hari);
		string bln = (Bulan < 10 ? "0" + Bulan.ToString() : Bulan.ToString());
		string hr = (Hari < 10 ? "0" + Hari.ToString() : Hari.ToString());
		string tgl = $"{Tahun}-{bln}-{hr}";
		JadwalKehadiranDTO? jadwalKerja = new();
		jadwalKerja = await jadwalKehadiranService!.GetByNamaAndDate(Nama, tgl);

		if(jadwalKerja != null){
			var jadwalShift = await jadwalShiftSecurityService!.GetByInisialAsync(jadwalVal);
			jadwalKerja.Shift = jadwalShift!.Deskripsi;
			jadwalKerja.Inisial_Shift = jadwalVal;
			CultureInfo culture = new CultureInfo("id-ID");
			jadwalKerja.JadwalMasuk = Convert.ToDateTime($"{tgl} {jadwalShift.JadwalMasuk}", culture);
			jadwalKerja.JadwalPulang = DateTime.Parse($"{tgl} {jadwalShift.JadwalPulang}", culture);
			var jadwalKerjaUpdated = await jadwalKehadiranService.UpdateJadwal(jadwalKerja);
			if (jadwalKerjaUpdated != null) {
				SnackBar.Add("Update Jadwal Kerja security berhasil di updated", Severity.Success, config => {
					config.HideTransitionDuration = 200;
				});
				await tableJadwal!.ReloadServerData();
			}
		}

	}

