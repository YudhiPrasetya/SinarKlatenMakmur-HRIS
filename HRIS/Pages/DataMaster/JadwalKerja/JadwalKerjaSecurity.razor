	private async Task AddJadwal() {
		var dialogOptions = new DialogOptions { ClassBackground = "backdrops-style", DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Small, Position = DialogPosition.Center };
		var dialogParameters = new DialogParameters {
				["EmployeeDTOs"] = EmployeeDTOs,
				["jadwalShiftSecurityDTOs"] = jadwalShiftSecurityDTOs,
				["Bulan"] = bulan,
				["Tahun"] = tahun
			};
		var dialog = await DialogService.ShowAsync<AddJadwalKerjaSecurityDialog>("Tambah Data Jadwal Kerja Security", dialogParameters, dialogOptions);
		var dialogResult = await dialog.Result;
		if (!dialogResult.Canceled) {
			await tableJadwal!.ReloadServerData();
		}
	}

