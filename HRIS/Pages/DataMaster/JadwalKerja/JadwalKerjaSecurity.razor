	private async Task<TableData<Jadwal>> ServerJadwalReload(TableState state) {
		jadwalKehadiranDTOs = await jadwalKehadiranService!.GetByGroupAndRangePeriode(grupKerja, bulan, tahun);

		jadwalKehadiranData = jadwalKehadiranDTOs!.ToPivotArray(
			item => item.JadwalMasuk!.Value.Date.Day,
			item => item.Nama,
			items => items?.First().Inisial_Shift
		);
		jsonData = JsonConvert.SerializeObject(jadwalKehadiranData, new KeyValuePairConverter());
		var jsonArray = JArray.Parse(jsonData);
		jadwals.Clear();
		foreach (var data in jsonArray) {
			jadwals.Add(new Jadwal {
					Nama = (string?)data["Nama"],
					// NIK = (string?)data["NIK"],
					_1 = (string?)data["1"],
					_2 = (string?)data["2"],
					_3 = (string?)data["3"],
					_4 = (string?)data["4"],
					_5 = (string?)data["5"],
					_6 = (string?)data["6"],
					_7 = (string?)data["7"],
					_8 = (string?)data["8"],
					_9 = (string?)data["9"],
					_10 = (string?)data["10"],
					_11 = (string?)data["11"],
					_12 = (string?)data["12"],
					_13 = (string?)data["13"],
					_14 = (string?)data["14"],
					_15 = (string?)data["15"],
					_16 = (string?)data["16"],
					_17 = (string?)data["17"],
					_18 = (string?)data["18"],
					_19 = (string?)data["19"],
					_20 = (string?)data["20"],
					_21 = (string?)data["21"],
					_22 = (string?)data["22"],
					_23 = (string?)data["23"],
					_24 = (string?)data["24"],
					_25 = (string?)data["25"],
					_26 = (string?)data["26"],
					_27 = (string?)data["27"],
					_28 = (string?)data["28"],
					_29 = (string?)data["29"],
					_30 = (string?)data["30"],
					_31 = (string?)data["31"]
				});
		}

		await Task.Delay(300);
		// jadwals = jadwals.Where(element => {
		// 	if (string.IsNullOrWhiteSpace(searchString))
		// 		return true;
		// 	if (element.Nama.Contains(searchString, StringComparison.OrdinalIgnoreCase))
		// 		return true;
		// 	if ($"{element.Nama}".Contains(searchString))
		// 		return true;
		// 	return false;
		// }).ToArray();
		totalItems = jadwals.Count();

		pagedData = jadwals.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
		return new TableData<Jadwal>() { TotalItems = totalItems, Items = pagedData };
	}

