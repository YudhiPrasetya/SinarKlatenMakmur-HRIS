	private async Task EditInisial(string nama, int hari, int bln, int thn) {
		var strTglJadwal = new DateTime(thn, bln, hari).ToString("yyyy-MM-dd");
		var result = await jadwalKehadiranService!.GetByNamaAndDate(nama, strTglJadwal);

		if(result != null){
			var dialogOptions = new DialogOptions { ClassBackground = "backdrops-style", DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Small, Position = DialogPosition.Center };
			var dialogParameters = new DialogParameters {
					["jadwalKehadiranDTO"] = result,
				};
			var dialog = await DialogService.ShowAsync<EditJadwalKehadiranKaryawanDialog>("Edit Data Jadwal Shift Kerja Karyawan", dialogParameters, dialogOptions);
			var dialogResult = await dialog.Result;

			if (!dialogResult.Canceled) {
				await proses();
			}
		}

	}

	private async Task<IEnumerable<GroupDTO>?> SearchGroup(string value) {
		await Task.Delay(250);
		if (string.IsNullOrEmpty(value))
			return await groupService!.GetListGroupsAsync();
		return await groupService!.GetByGroupName(value);
	}

