		<MudAutocomplete @bind-Value="selectedGroup" Margin="Margin.Dense" Dense="true" Label="Grup Kerja" T="GroupDTO" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" SearchFunc="SearchGroup" ToStringFunc="@(g => g == null ? null : $"{g.GroupDesc}")" ShowProgressIndicator="true" ProgressIndicatorColor="Color.Secondary"/>

	</MudItem>
	<MudItem xs="3" sm="3">
		<MudButton OnClick="proses" Color="Color.Info" Variant="Variant.Filled" Disabled="processing">
			@if (processing) {
				<MudProgressCircular Class="ms-n1" Size="Size.Small" Color="Color.Success" Indeterminate="true" />
