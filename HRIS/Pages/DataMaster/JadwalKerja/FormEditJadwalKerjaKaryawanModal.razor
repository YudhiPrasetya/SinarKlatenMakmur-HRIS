	private async void SearchJadwal() {
		disableBtnCari = true;
		prosesCari = true;

		// string group = groupValue.GroupDesc;
		// string strGroup = group.Replace("/", "-").Replace(" ", "_");
		string strGroup = "All";
		string startDate = DateConversions.DateToString(_dateRange.Start.Value.Date);
		string endDate = DateConversions.DateToString(_dateRange.End.Value.Date);

		jadwalKerjaKaryawanDTOs.Clear();

		jadwalKerjaKaryawanDTOs = await jadwalKerjaKaryawanService.GetByGroupAndDate(strGroup, startDate, endDate);
		disableBtnCari = false;
		prosesCari = false;
		StateHasChanged();

	}

	void AddSelectedJadwal() {
		foreach (var i in selectedItems) {
			JadwalKerjaKaryawanDTO jadwal = new()
				{
					Id = i.Id,
					NIK = i.NIK,
					GroupName = i.GroupName,
					NamaKaryawan = i.NamaKaryawan,
					Tgl = i.Tgl,
					JamMasuk = i.JamMasuk,
					JamPulang = i.JamPulang
				};
			selectedJadwalDTOs.Add(jadwal);
		}
		selectedItems.Clear();
		disabledOKButton = true;
		disableBtnSave = false;
	}

	bool DelSelectedJadwal(int id) {
		JadwalKerjaKaryawanDTO? selectedJadwal = selectedJadwalDTOs.Where(e => e.Id == id).SingleOrDefault();
		var del = selectedJadwalDTOs.Remove(selectedJadwal!);
		return del;
	}

	void OnRowClicked(TableRowClickEventArgs<JadwalKerjaKaryawanDTO> args) {
		if (selectedItems.Count <= 0) {
			// disabledOKButton = true;
			disableBtnSave = true;
		}
		else {
			// disabledOKButton = false;
			disableBtnSave = false;
		}
	}
