	private void ModalClose() {
		MudDialog?.Close(DialogResult.Ok(true));
	}

	private async Task<IEnumerable<GroupDTO>> GroupSearch(string val) {
		await Task.Delay(5);
		// if (string.IsNullOrEmpty(val)) return groupDTOs.Select(g => g.GroupDesc);

		return groupDTOs.Where(g => g.GroupDesc.Contains(val)); 
	}

	private bool FilterFunc1(JadwalKerjaKaryawanDTO element) => FilterFunc(element, searchString1);

	private bool FilterFunc(JadwalKerjaKaryawanDTO element, string searchString) {
		if (string.IsNullOrWhiteSpace(searchString))
			return true;
		if (element.NamaKaryawan.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.Tgl.Value.Date.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.JamMasuk.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.JamPulang.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if ($"{element.NamaKaryawan} {element.NIK} {element.Tgl.Value.Date.ToString()} {element.JamMasuk.ToString()} {element.JamPulang.ToString()}".Contains(searchString))
			return true;
		return false;
	}

	private async void JadwalSave() {
		saveProcessing = true;
		// disableBtnSave = true;

		List<JadwalKerjaKaryawanDTO> listUpdateJadwal = new();
		// foreach (JadwalKerjaKaryawanDTO j in selectedJadwalDTOs) {
		foreach (JadwalKerjaKaryawanDTO j in selectedItems) {
			JadwalKerjaKaryawanDTO jadwal = new()
			{
				Id = j.Id,
				GroupName = j.GroupName,
				NIK = j.NIK,
				NamaKaryawan = j.NamaKaryawan,
				Tgl = j.Tgl,
				JamMasuk = jamMasuk.Value,
				JamPulang = jamPulang.Value
			};
			listUpdateJadwal.Add(jadwal);
		}
		selectedItems.Clear();
		var jadwalUpdated = await jadwalKerjaKaryawanService.UpdateJadwalKerjaKaryawanRange(listUpdateJadwal);
		Snackbar.Add("Jadwal Karyawan berhasil diubah!", Severity.Success, configure =>
		{
			configure.HideTransitionDuration = 200;
		});
		saveProcessing = false;
		// disableBtnSave = false;
	}

