	// 	Console.WriteLine(text);
	// 	if(text != "Lainnya") {
	// 		var jadwalShiftKaryawan = jadwalShiftKaryawanDTOs.Where(j => j.Deskripsi == text).SingleOrDefault();
	// 		jadwalKerjaKaryawanDTO.JamMasuk = jadwalShiftKaryawan.JadwalMasuk.Value;
