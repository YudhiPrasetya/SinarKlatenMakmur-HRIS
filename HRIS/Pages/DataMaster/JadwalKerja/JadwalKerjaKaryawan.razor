@inject IDialogService DialogService
@inject ISnackbar SnackBar

<MudTable Class="mt-5 cursor-pointer" ServerData="@(new Func<TableState, Task<TableData<JadwalKehadiranDTO>>>(ServerReload))"
          Dense="true" Hover="true" @ref="tableJadwalKerjaKaryawan" Elevation="4" FixedHeader="true" FixedFooter="true" Striped="true" Bordered="false" CanCancelEdit="true" @bind-SelectedItem="jadwalKerjaKaryawan" RowEditPreview="BackupJadwal" RowEditCommit="CommitJadwal" IsEditRowSwitchingBlocked="true" RowEditCancel="CancelEdit" >
   <ToolBarContent>
      <MudText Typo="Typo.h6">Daftar Jadwal Kerja Karyawan</MudText>
      <MudFab Class="ma-2" OnClick="ShowFormJadwalKerjaKaryawan" Icon="@Icons.Material.Filled.Add" Color="Color.Secondary" Size="Size.Small"></MudFab>
      <MudFab Class="ma-2" OnClick="ShowFormEditJadwalKerjaKaryawan" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"></MudFab>
      <MudFab Class="ma-2" Icon="@Icons.Material.Filled.CancelScheduleSend" Color="MudBlazor.Color.Info" Size="Size.Small" OnClick="ShowFormGantiHariKaryawan"></MudFab>
      <MudSpacer />
      <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
   </ToolBarContent>

