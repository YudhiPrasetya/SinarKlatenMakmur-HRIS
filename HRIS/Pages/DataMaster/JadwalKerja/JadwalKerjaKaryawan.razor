@inject IDialogService DialogService

@code {
   // [Inject]IJadwalKerjaKaryawanService jadwalKerjaKaryawanService { get; set; }
   [Inject]IJadwalKehadiranService jadwalKehadiranService { get; set; }
   [Inject]IEmployeeService employeeService { get; set; }
   [Inject]IGroupService groupService { get; set; }
   [Inject]IJadwalShiftKaryawanService jadwalShiftKaryawanService { get; set; }
   // [Inject]IJadwalShiftDepartemenService jadwalShiftDepartemenService { get; set; }

   private IEnumerable<JadwalKehadiranDTO>? jadwalDTOs = new List<JadwalKehadiranDTO>();
   private IEnumerable<EmployeeDTO> employeeDTOs = new List<EmployeeDTO>();
   private IEnumerable<GroupDTO> groupDTOs = new List<GroupDTO>();
   private IEnumerable<JadwalShiftKaryawanDTO> jadwalShiftKaryawanDTOs = new List<JadwalShiftKaryawanDTO>();
   private IEnumerable<JadwalShiftDepartemenDTO> jadwalShiftDepartemenDTOs = new List<JadwalShiftDepartemenDTO>();
   private List<JadwalKerjaKaryawanDTO> jadwalKerjaKaryawanDetail = new();
   private IEnumerable<JadwalKehadiranDTO> pagedData = new List<JadwalKehadiranDTO>();
   private string? searchString;
   private int totalItems;
   private string Mode = "Tambah";
   private List<NamaHari> listNamaHari = new();

   private MudTable<JadwalKehadiranDTO?>? tableJadwalKerjaKaryawan;

   private JadwalKehadiranDTO? jadwalKerjaKaryawan;
   private JadwalKehadiranDTO? jadwalBeforeEdit;

   // private TableGroupDefinition<JadwalKerjaKaryawanDTO> GroupDefinition = new() {
   //    GroupName = "Grup Kerja",
   //    Indentation = false,
   //    Expandable = true,
   //    Selector = (e) => e.GroupName
   // };

   private async Task<TableData<JadwalKehadiranDTO>> ServerReload(TableState state) {
      // jadwalDTOs = await jadwalKerjaKaryawanService.GetAllJadwalKerjaKaryawan();
      jadwalDTOs = await jadwalKehadiranService.GetListJadwalKehadiranAsync();
      await Task.Delay(300);
      jadwalDTOs = jadwalDTOs!.Where(element => {
         if (string.IsNullOrWhiteSpace(searchString))
            return true;
         if (element.GrupKerja!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.Nama!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
         if (element.NIK!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

         if ($"{element.GrupKerja} {element.NIK} {element.Nama}".Contains(searchString))
            return true;
         return false;
      }).ToArray();
      totalItems = jadwalDTOs.Count();
      switch (state.SortLabel) {
         case "id_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.Id);
         break;
         case "nik_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.NIK);
         break;
         case "nama_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.Nama);
         break;
         case "grup_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.GrupKerja);
         break;
         case "jadwalMasuk_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.JadwalMasuk);
         break;
         case "jadwalPulang_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.JadwalPulang);
         break;
         case "jamMasuk_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.JamMasuk);
         break;
         case "jamPulang_field":
         jadwalDTOs = jadwalDTOs.OrderByDirection(state.SortDirection, o => o.JamPulang);
         break;

      }

      pagedData = jadwalDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
      return new TableData<JadwalKehadiranDTO>() { TotalItems = totalItems, Items = pagedData };
   }

   protected override async Task OnInitializedAsync() {
      // return base.OnInitializedAsync();
      employeeDTOs = await employeeService.GetListEmployeesAsync();
      groupDTOs = await groupService.GetListGroupsAsync();
      jadwalShiftKaryawanDTOs = await jadwalShiftKaryawanService.GetJadwalShiftKaryawan();
      // jadwalShiftDepartemenDTOs = await jadwalShiftDepartemenService.GetJadwalShiftDepartemen();
      listNamaHari.Add(new NamaHari { HariNum = "1", HariName = "Senin" });
      listNamaHari.Add(new NamaHari { HariNum = "2", HariName = "Selasa" });
      listNamaHari.Add(new NamaHari { HariNum = "3", HariName = "Rabu" });
      listNamaHari.Add(new NamaHari { HariNum = "4", HariName = "Kamis" });
      listNamaHari.Add(new NamaHari { HariNum = "5", HariName = "Jumat" });
      listNamaHari.Add(new NamaHari { HariNum = "6", HariName = "Sabtu" });
   }

   private void OnSearch(string text) {
      searchString = text;
      tableJadwalKerjaKaryawan!.ReloadServerData();
   }

   private async void ShowFormJadwalKerjaKaryawan() {
      Mode = "Tambah";
      var parameters = new DialogParameters {
            ["ModalLabel"] = $"{Mode} Data Jadwal Kerja Karyawan",
            ["employeeDTOs"] = employeeDTOs,
            ["groupDTOs"] = groupDTOs,
            // ["jadwalShiftKaryawanDTOs"] = jadwalShiftKaryawanDTOs,
            // ["jadwalShiftDepartemenDTOs"] = jadwalShiftDepartemenDTOs,
            ["Mode"] = Mode,
            ["listNamaHari"] = listNamaHari
      };

      var options = new DialogOptions() { 
         CloseButton = false, 
         MaxWidth = MaxWidth.Large, 
         FullWidth = true, 
         Position = DialogPosition.TopCenter, 
         DisableBackdropClick = true,
         FullScreen = true
      };

      var dialog = await DialogService.ShowAsync<FormJadwalKerjaKaryawanModal>($"{Mode} Data Jadwal Kerja Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         await tableJadwalKerjaKaryawan!.ReloadServerData();
      }
   }

   private void BackupJadwal(object element) {
      jadwalBeforeEdit = new() {
            GrupKerja = ((JadwalKehadiranDTO)element).GrupKerja,
            Id = ((JadwalKehadiranDTO)element).Id,
            NIK = ((JadwalKehadiranDTO)element).NIK,
            Nama = ((JadwalKehadiranDTO)element).Nama,
            JadwalMasuk = ((JadwalKehadiranDTO)element).JadwalMasuk,
            JadwalPulang = ((JadwalKehadiranDTO)element).JadwalPulang,
            JamMasuk = ((JadwalKehadiranDTO)element).JamMasuk,
            JamPulang = ((JadwalKehadiranDTO)element).JamPulang,
            Keterangan = ((JadwalKehadiranDTO)element).Keterangan
      };
   }

   private void CancelEdit(object element) {
      ((JadwalKehadiranDTO)element).GrupKerja = jadwalBeforeEdit!.GrupKerja;
      ((JadwalKehadiranDTO)element).Id = jadwalBeforeEdit.Id;
      ((JadwalKehadiranDTO)element).NIK = jadwalBeforeEdit.NIK;
      ((JadwalKehadiranDTO)element).Nama = jadwalBeforeEdit.Nama;
      ((JadwalKehadiranDTO)element).JadwalMasuk = jadwalBeforeEdit.JadwalMasuk;
      ((JadwalKehadiranDTO)element).JadwalPulang = jadwalBeforeEdit.JadwalPulang;
      ((JadwalKehadiranDTO)element).JamMasuk = jadwalBeforeEdit.JamMasuk;
      ((JadwalKehadiranDTO)element).JamPulang = jadwalBeforeEdit.JamPulang;
      ((JadwalKehadiranDTO)element).Keterangan = jadwalBeforeEdit.Keterangan;
   }

   private void CommitJadwal(object el) {
      UpdateJadwalKaryawan(((JadwalKehadiranDTO)el));
   }

   private async void UpdateJadwalKaryawan(JadwalKehadiranDTO jadwal) {

      var jadwalUpdated = await jadwalKehadiranService.UpdateJadwalKehadiran(jadwal);
      if (jadwalUpdated != null) {
         SnackBar.Add("Update Jadwal Kerja Karyawan berhasil di updated", Severity.Success, config => {
            config.HideTransitionDuration = 200;
         });
      }
   }

   private async void ShowFormEditJadwalKerjaKaryawan() {
      Mode = "Edit";
      var parameters = new DialogParameters {
            ["ModalLabel"] = $"{Mode} Data Jadwal Kerja Karyawan",
            ["groupDTOs"] = groupDTOs,
         };

      var options = new DialogOptions() { CloseButton = false, MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, Position = DialogPosition.Center, DisableBackdropClick = true};

      var dialog = await DialogService.ShowAsync<FormEditJadwalKerjaKaryawanModal>($"{Mode} Data Jadwal Kerja Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         await tableJadwalKerjaKaryawan.ReloadServerData();
      }
   }

   private async void ShowFormGantiHariKaryawan() {
      var parameters = new DialogParameters {
         // ["ModalLabel"] = $"Ganti Jadwal Kerja Karyawan",
         ["groupDTOs"] = groupDTOs,
      };

      var options = new DialogOptions() { CloseButton = false, MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, Position = DialogPosition.Center, DisableBackdropClick = true };

      var dialog = await DialogService.ShowAsync<FormGantiHariJadwalKaryawanModal>("Ganti Jadwal Kerja Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {
         await tableJadwalKerjaKaryawan.ReloadServerData();
      }
   }
}
