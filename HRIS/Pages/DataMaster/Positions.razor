   async Task DeletePosition(int Id) {
      bool? deleteConfirmation = await DialogService.ShowMessageBox("Konfirmasi", "Yakin akan menghapus?", "Ya", "Tidak");
      if (deleteConfirmation == true) {
         var response = await positionService.DeletePosition(Id);
         if (response != null) {
            await positionTable.ReloadServerData();
            Snackbar.Add("Data posisi/jabatab berhasil dihapus.", Severity.Info, config => {
               config.HideTransitionDuration = 100;
            });
