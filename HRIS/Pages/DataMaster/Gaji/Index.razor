					<MudButton StartIcon="@Icons.Material.Filled.AddToQueue" IconColor="Color.Secondary" OnClick="ShowMultiForm">Tambah Sekaligus</MudButton>
				</MudButtonGroup>
			</CardHeaderActions>
		</MudCardHeader>
		<MudCardContent>
			<MudTable ServerData="@(new Func<TableState, Task<TableData<GajiDanTunjanganDTO>>>(ServerReload))" Dense="true" T="GajiDanTunjanganDTO" Hover="true" @ref="gajiTable" FixedHeader="true" FixedFooter="true" Bordered="true" Class="cursor-pointer" Striped="true" Breakpoint="Breakpoint.Sm" CustomHeader="true" CustomFooter="true" HeaderClass="table-head-bordered" FooterClass="table-foot-bordered">
