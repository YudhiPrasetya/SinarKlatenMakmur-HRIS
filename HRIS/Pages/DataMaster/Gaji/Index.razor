				</ToolBarContent>
				<HeaderContent>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="id_field" T="GajiDanTunjanganDTO">ID</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="group_field" T="GajiDanTunjanganDTO">Grup</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="nik_field" T="GajiDanTunjanganDTO">NIK</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="namaKaryawan_field" T="GajiDanTunjanganDTO">Nama</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="upah_field" T="GajiDanTunjanganDTO">Upah</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="ptkp_field" T="GajiDanTunjanganDTO">Keterangan</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="ptkpRP_field" T="GajiDanTunjanganDTO">Jumlah</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="tunjJabatan_field" T="GajiDanTunjanganDTO">Jabatan</MudTableSortLabel>
					</MudTh>
					<MudTh Class="mud-theme-info">
						<MudTableSortLabel SortLabel="tunjKeterampilan_field" T="GajiDanTunjanganDTO">Keterampilan</MudTableSortLabel>
