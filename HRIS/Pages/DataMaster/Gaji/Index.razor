	protected override async Task OnInitializedAsync() {
		// return base.OnInitializedAsync();
		await Task.Delay(50);
		dataLoaded = false;
		overlayVisible = true;
		// gajiDTOs = await gajiService.GetGajiListAsync();
		// data = await gajiService.GetGajiListAsync();
		empDTOs = await empService.GetListEmployeesAsync();
		umpDTOs = await umpService.GetUMP();
		ptkpDTOs = await ptkpService.GetPTKPAsync();
		dataLoaded = true;
		overlayVisible = false;
		StateHasChanged();
	}

	private async Task<TableData<GajiDanTunjanganDTO>> ServerReload(TableState state) {
		IEnumerable<GajiDanTunjanganDTO> data = await gajiService.GetGajiListAsync();
		// data = await gajiService.GetGajiListAsync();
		await Task.Delay(300);
		data = data.Where(el => {
			if (string.IsNullOrWhiteSpace(searchString)) return true;
			if (el.GrupKerja.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.NIK.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if (el.NamaKaryawan.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
			if ($"{el.GrupKerja}{el.NIK}{el.NamaKaryawan}".Contains(searchString)) return true;
			return false;
		}).ToArray();
		totalItems = data.Count();
		switch (state.SortLabel) {
			case "id_field":
			data = data.OrderByDirection(state.SortDirection, o => o.Id);
			break;
			case "group_field":
			data = data.OrderByDirection(state.SortDirection, o => o.GrupKerja);
			break;
			case "nik_field":
			data = data.OrderByDirection(state.SortDirection, o => o.NIK);
			break;
			case "namaKaryawan_field":
			data = data.OrderByDirection(state.SortDirection, o => o.NamaKaryawan);
			break;
		}

		// pagedData = gajiDTOs.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
		pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();
		return new TableData<GajiDanTunjanganDTO>() { TotalItems = totalItems, Items = pagedData };
	}

	private void OnSearch(string text) {
		searchString = text;
		gajiTable.ReloadServerData();
	}
	async Task EditGajiDanTunjangan(GajiDanTunjanganDTO gaji) {
		Mode = "Edit";
		var parameters = new DialogParameters
		{
			["ModalLabel"] = $"{Mode} Data Gaji dan Tunjangan",
			["gajiDTO"] = gaji,
			["ptkpDTOs"] = ptkpDTOs,
			["umpDTOs"] = umpDTOs,
			["empDTOs"] = empDTOs,
			["Mode"] = Mode,
			["OnGajiUpdate"] = EventCallback.Factory.Create<GajiDanTunjanganDTO>(this, OnGajiUpdate)
		};
		var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };
		var dialog = await DialogService.ShowAsync<FormGajiSingleModal>("", parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled) {
			Mode = "Add";
		}
	}

	async Task HapusGajiDanTunjangan(int Id) {
		// await DeleteGaji.InvokeAsync(Id);
		var rst = await DialogService.ShowMessageBox("Konfirmasi Hapus", "Yakin Akan Menghapus?","Ya", "Tidak");
		if(rst == true) {
			var deleted = await gajiService.DeleteGajiAsync(Id);
			await gajiTable.ReloadServerData();
			Snackbar.Add($"Data Gaji Tunjangan atas nama <strong>{deleted.NamaKaryawan}</strong> berhasil dihapus!", Severity.Error);
		}

	}

