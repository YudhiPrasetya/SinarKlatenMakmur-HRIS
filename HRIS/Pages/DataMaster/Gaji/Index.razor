			var dataGajiDTOs = rst.Data as List<GajiDanTunjanganDTO>;
			await gajiService.AddGajiRangeAsync(dataGajiDTOs);
			await gajiTable.ReloadServerData();
			await Task.Delay(100);
			Snackbar.Add("Data gaji dan tunjangan berhasil di-TAMBAHKAN sekaligus", Severity.Success, cfg =>
			{
				cfg.HideTransitionDuration = 50;
			});
			// StateHasChanged();
		}
	}

