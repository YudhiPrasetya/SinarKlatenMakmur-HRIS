			<CardHeaderAvatar>
				<MudSkeleton SkeletonType="SkeletonType.Circle" Height="40px" Width="40px" Animation="Animation.Wave"></MudSkeleton>
			</CardHeaderAvatar>
			<CardHeaderContent>
				<MudSkeleton SkeletonType="SkeletonType.Text" Height="40px" Width="100px" Animation="Animation.Wave"></MudSkeleton>
				<MudSkeleton SkeletonType="SkeletonType.Text" Height="40px" Width="200px" Animation="Animation.Wave"></MudSkeleton>
			</CardHeaderContent>
			<CardHeaderActions>
				<MudSkeleton Animation="Animation.Wave" Width="250px" Height="37px" />
			</CardHeaderActions>
		</MudCardHeader>
		<MudCardContent>
			<MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Width="1038px" Height="257px" />
		</MudCardContent>
		<MudOverlay Visible="overlayVisible" DarkBackground="false" Absolute="true">
			<MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
		</MudOverlay>
	}
	else {
		<MudCardHeader>
			<CardHeaderAvatar>
				<MudAvatar Color="Color.Secondary">G</MudAvatar>
			</CardHeaderAvatar>
			<CardHeaderContent>
