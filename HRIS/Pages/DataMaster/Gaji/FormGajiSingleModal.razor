@using HRIS.Pages.SharedModal;
@using SKM.Shared.Dtos
@using HRIS.Components
@using HRIS.Contracts
@using HRIS.Services
@using System.Globalization;

@inject IDialogService DialogService
@inject ISnackbar Snackbar;

<MudDialog>
	<DialogContent>
      <MudCard Class="mx-1 pa-1" Elevation="1">
         <MudCardHeader>
            <CardHeaderAvatar>
               <MudAvatar Color="Color.Primary">F</MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
               <MudText Typo="Typo.body1"><strong>Form Gaji dan Tunjangan</strong></MudText>
               <MudText Typo="Typo.body2">Untuk mengisi data gaji dan tunjangan</MudText>
            </CardHeaderContent>
         </MudCardHeader>
         <MudCardContent>
            <MudForm @ref="gajiSatuForm">
               <MudGrid>
                  <MudItem Class="pa-2" sm="1">
                     <MudTextField @bind-Value="@gajiDTO.Id" @ref="Id" Label="Id" Disabled="true" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
                  </MudItem>
                  <MudItem sm="3" Class="pa-2" >
                     <MudTextField @ref="NIK" @bind-Value="@gajiDTO.NIK" Class="pa-0" T="string" Label="NIK" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="CariKaryawan" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
                  </MudItem>

                  <MudItem sm="4" Class="pa-2">
                     <MudTextField @ref="@namaKaryawan" T="string" Label="Nama Karyawan" @bind-Value="gajiDTO.NamaKaryawan" Disabled="true" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
                  </MudItem>
                  <MudItem sm="4" Class="pa-2">
                     <MudTextField @ref="grupKerja" T="string" Disabled="true" Label="Grup Kerja" @bind-Value="@gajiDTO.GrupKerja" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
                  </MudItem>
               </MudGrid>
               <MudGrid>
                  <MudItem sm="4" Class="pa-2">
                     <MudSelect @ref="UMP" T="int" Label="UMP..." Margin="Margin.Dense" Variant="Variant.Outlined" ValueChanged="@OnUMPValueChanged">
                        <MudSelectItem Value="0">Input Manual</MudSelectItem>
                        @foreach (var umpDTO in umpDTOs.OrderByDescending(u => u.Id)) {
                           <MudSelectItem Value="umpDTO.Jumlah">@umpDTO.Keterangan</MudSelectItem>
                        }
                     </MudSelect>
                  </MudItem>
                  <MudItem sm="4" Class="pa-2">
                     <MudNumericField T="decimal" Label="Upah" @ref="Upah" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="gajiDTO.Upah"></MudNumericField>
                  </MudItem>
                  <MudItem sm="4" Class="pa-2">
                     <MudSelect Placeholder="PTKP" T="string" @ref="PTKP" Label="PTKP..." Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Text="@gajiDTO.PTKP" ValueChanged="@OnPTKPValueChanged" >
                        @foreach (var ptkpDTO in ptkpDTOs) {
                           <MudSelectItem Value="@($"{ptkpDTO.Keterangan}-{ptkpDTO.Jumlah}")">@ptkpDTO.Keterangan</MudSelectItem>
                        }
                     </MudSelect>
                  </MudItem>
                  <MudNumericField T="int?" Class="invisible" @ref="PTKP_Jml" @bind-Value="gajiDTO.PTKP_Jumlah" />
               </MudGrid>

               <MudGrid>
                  <MudItem sm="6" Class="pa-2">
                     <MudField Label="Tunjangan" Variant="Variant.Outlined">
                        <MudNumericField @ref="TunjJabatan" @bind-Value="gajiDTO.TunjJabatan" Label="Jabatan" T="int?"></MudNumericField>
                        <MudNumericField @ref="TunjKeterampilan" @bind-Value="gajiDTO.TunjKeterampilan" Label="Keterampilan" T="int?"></MudNumericField>
                        <MudNumericField @ref="TunjLain" @bind-Value="gajiDTO.TunjLain" Label="DLL" T="int?"></MudNumericField>
                     </MudField>
                  </MudItem>
                  <MudItem sm="6" Class="pa-2">
                     <MudField Label="Potongan" Variant="Variant.Outlined">
                        <MudNumericField @ref="PotonganKoperasi" @bind-Value="gajiDTO.PotonganKoperasi" Label="Koperasi" T="int?"></MudNumericField>
                        <MudNumericField @ref="PotonganLain" @bind-Value="gajiDTO.PotonganLain" Label="DLL" T="int?"></MudNumericField>
                     </MudField>
                  </MudItem>
               </MudGrid>

               <MudGrid>
                  <MudItem sm="6" Class="pa-2">
                     <MudField Label="BPJS Tenaga Kerja" Variant="Variant.Outlined" InnerPadding="false">
                        <MudRadioGroup @bind-SelectedOption="gajiDTO.Potong_BPJSTK" @ref="BPJSTK" Class="pa-1">
                           <MudRadio Option="@("T")">Potong</MudRadio>
                           <MudRadio Option="@("F")">Tidak</MudRadio>
                        </MudRadioGroup>
                     </MudField>
                  </MudItem>
                  <MudItem sm="6" Class="pa-2">
                     <MudField Label="BPJS Kesehatan" Variant="Variant.Outlined" InnerPadding="false">
                        <MudRadioGroup @bind-SelectedOption="gajiDTO.Potong_BPJSKes" @ref="BPJSKes" Class="pa-1">
                           <MudRadio Option="@("T")">Potong</MudRadio>
                           <MudRadio Option="@("F")">Tidak</MudRadio>
                        </MudRadioGroup>
                     </MudField>
                  </MudItem>
               </MudGrid>
               <MudGrid>
                  <MudItem sm="12" Class="pa-2">
                     <MudField Variant="Variant.Outlined" Label="BPJS Kesehatan Orang Tua">
                        <MudGrid>
                           <MudItem sm="6" Class="pa-2">
                              <MudNumericField Label="Orang Tua 1(%)" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu1" @ref="BPJSOrtu1" Format="F2"></MudNumericField>
                              <MudNumericField Label="Orang Tua 2(%)" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu2" @ref="BPJSOrtu2" Format="F2"></MudNumericField>
                           </MudItem>
                           <MudItem sm="6" Class="pa-2">
                              <MudNumericField Label="Orang Tua 3(%)" @ref="BPJSOrtu3" T="decimal?" @bind-Value=gajiDTO.BPJS_Ortu3 Format="F2"></MudNumericField>
                              <MudNumericField Label="Orang Tua 4(%)" @ref="BPJSOrtu4" T="decimal?" @bind-Value="gajiDTO.BPJS_Ortu4" Format="F2"></MudNumericField>
                           </MudItem>
                        </MudGrid>
                     </MudField>
                  </MudItem>
               </MudGrid>
            </MudForm>
         </MudCardContent>
         <MudCardActions>
            <MudStack Row="true" Spacing="5">
               <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Filled" Color="Color.Success" OnClick="Save">Save</MudButton>
               <MudButton StartIcon="@Icons.Material.Filled.Cancel" Variant="Variant.Filled" Color="Color.Warning" OnClick="Cancel">Cancel</MudButton>
            </MudStack>
         </MudCardActions>
      </MudCard>
      
	</DialogContent>
</MudDialog>

@code {
   [Inject]IGajiDanTunjanganService gajiService { get; set; }
   private IEnumerable<GajiDanTunjanganDTO> gajiDTOS = new List<GajiDanTunjanganDTO>();
   private MudForm gajiSatuForm;
   [Parameter]public GajiDanTunjanganDTO gajiDTO { get; set; } = new GajiDanTunjanganDTO();
   private MudTextField<int> Id;
   private MudTextField<string> NIK;
   private MudTextField<string> grupKerja;
   private MudTextField<string> namaKaryawan;
   private MudSelect<int> UMP;
   private MudSelect<string> PTKP;
   private MudNumericField<int?> PTKP_Jml;
   private string selectedBPJSKes { get; set; }
   private string selectedBPJSTK { get; set; }
   private MudNumericField<decimal> Upah { get; set; }
   private MudNumericField<decimal?> BPJSOrtu1 { get; set; }
   private MudNumericField<decimal?> BPJSOrtu2 { get; set; }
   private MudNumericField<decimal?> BPJSOrtu3 { get; set; }
   private MudNumericField<decimal?> BPJSOrtu4 { get; set; }
   private MudNumericField<int?> TunjJabatan { get; set; }
   private MudNumericField<int?> TunjKeterampilan { get; set; }
   private MudNumericField<int?> TunjLain { get; set; }
   private MudNumericField<int?> PotonganKoperasi { get; set; }
   private MudNumericField<int?> PotonganLain { get; set; }
   private MudRadioGroup<string?> BPJSTK { get; set; }
   private MudRadioGroup<string?> BPJSKes { get; set; }

   [Parameter]
   public IEnumerable<EmployeeDTO> empDTOs { get; set; }

   [Parameter]
   public IEnumerable<UpahMinimumProvinsiDTO> umpDTOs { get; set; }

   [Parameter]
   public IEnumerable<PenghasilanTidakKenaPajakDTO> ptkpDTOs { get; set; }
   [Parameter] public string? ModalLabel { get; set; }
   [Parameter]public string Mode { get; set; }
   [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

   [Parameter]public EventCallback<GajiDanTunjanganDTO> OnGajiAdded { get; set; }
   [Parameter]public EventCallback<GajiDanTunjanganDTO> OnGajiUpdate { get; set; }
   public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
   private EmployeeDTO empDTO = new EmployeeDTO();

   async Task CariKaryawan() {
      var parameters = new DialogParameters<SearchEmployeeModal>();
      parameters.Add("ModalLabel", "Cari Data Karyawan");
      parameters.Add("EmployeeDTOS", empDTOs);
      //parameters.Add("GroupDTOS", Groups);
      var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, Position = DialogPosition.TopCenter, DisableBackdropClick = true };
      var dialog = await DialogService.ShowAsync<SearchEmployeeModal>("Data Karyawan", parameters, options);
      var result = await dialog.Result;
      if (!result.Canceled) {

         empDTO = result.Data as EmployeeDTO;

         gajiDTO.GrupKerja = empDTO.GroupName;
         gajiDTO.NIK = empDTO.NIK;
         gajiDTO.NamaKaryawan = empDTO.Name;
         // gajiDTO.GroupId = empDTO.GroupID;
         gajiDTO.GrupKerja = empDTO.GroupName;
         // gajiDTO.DepartmentId = empDTO.DepartmentId;
         // gajiDTO.DepartmentName = empDTO.DepartmentName;
         //IdEmployee.Value = empDTO.EmployeeId;
         //NIK.Value = empDTO.NIK;
         //Nama.Value = empDTO.Name;
      }
   }

   private async void Save() {
      //string[] arrPTKP = PTKP.Value.Split("-");

      GajiDanTunjanganDTO dataGaji = new GajiDanTunjanganDTO
      {
         Id = gajiDTO.Id,
         // GroupId = empDTO.GroupID.Value,
         GrupKerja = gajiDTO.GrupKerja,
         EmployeeId  = empDTO.EmployeeId,
         NIK = gajiDTO.NIK,
         NamaKaryawan = gajiDTO.NamaKaryawan,
         // DepartmentId = empDTO.DepartmentId.Value,
         // DepartmentName = empDTO.DepartmentName,
         Upah = gajiDTO.Upah,
         //PTKP = (Mode == "Tambah" ? arrPTKP[0] : gajiDTO.PTKP),
         PTKP = gajiDTO.PTKP,
         //PTKP_Jumlah = (Mode == "Tambah" ? int.Parse(arrPTKP[1]) : gajiDTO.PTKP_Jumlah),
         PTKP_Jumlah = gajiDTO.PTKP_Jumlah,
         TunjJabatan = gajiDTO.TunjJabatan,
         TunjKeterampilan = gajiDTO.TunjKeterampilan,
         TunjMasaKerja = 0,
         TunjLain = gajiDTO.TunjLain,
         PotonganKoperasi = gajiDTO.PotonganKoperasi,
         PotonganLain = gajiDTO.PotonganLain,
         Potong_BPJSKes = BPJSKes.SelectedOption,
         Potong_BPJSTK = BPJSTK.SelectedOption,
         BPJS_Ortu1 = gajiDTO.BPJS_Ortu1,
         BPJS_Ortu2 = gajiDTO.BPJS_Ortu2,
         BPJS_Ortu3 = gajiDTO.BPJS_Ortu3,
         BPJS_Ortu4 = gajiDTO.BPJS_Ortu4,
         CreatedAt = DateTime.Now,
         CreatedBy = 1,
         UpdatedBy = 1,
         UpdatedAt = DateTime.Now,
      };

      // Console.WriteLine(
      //    $"dataGaji.Id: {dataGaji.Id}, dtGaji.NIK: {dataGaji.NIK}, dtGaji.NamaKaryawan: {dataGaji.NamaKaryawan}, dtGaji.PTKP: {dataGaji.PTKP}, dtGaji.PTKP_Jumlah: {dataGaji.PTKP_Jumlah}, dtGaji.GroupId: {dataGaji.GroupId}, dtGaji.DepartmentId: {dataGaji.DepartmentId}"
      // );

      Console.WriteLine(GetAllProperties(dataGaji));

      if(Mode == "Tambah") {
         // var gaji = await gajiService.AddGajiAsync(dataGaji);
         await OnGajiAdded.InvokeAsync(dataGaji);
         await gajiSatuForm.ResetAsync();
      }
      else {
         // var gaji = await gajiService.UpdateGajiAsync(dataGaji);
         await OnGajiUpdate.InvokeAsync(dataGaji);
         MudDialog?.Close();
      }

   }

   private void Cancel() {
      MudDialog?.Close();
   }

   private void OnUMPValueChanged(int selectedUpah) {
      gajiDTO.Upah = selectedUpah;
      Upah.AutoFocus = true;
   }

   private void OnPTKPValueChanged(string selectedPTKP) {
      string[] arrSelectedVal = selectedPTKP.Split("-");

      gajiDTO.PTKP = arrSelectedVal[0];
      gajiDTO.PTKP_Jumlah = int.Parse(arrSelectedVal[1]);
      // gajiDTO.PTKP_Jumlah = int.Parse(selectedPTKP);
      
   }

   private void OnPTKPTextChanged(string text) {
      gajiDTO.PTKP = text;
   }

   private static string GetAllProperties(object obj) {
      return string.Join(" ", obj.GetType()
                                  .GetProperties()
                                  .Select(prop => prop.GetValue(obj)));
   }
}
