@page "/login"
@* @attribute [AllowAnonymous] *@

@using HRIS.Contracts;
@using HRIS.Services;
@using Newtonsoft.Json
@using Models
@using System.Net

@inject NavigationManager navigationManager
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject ITokenService tokenService


<MudContainer Class="d-flex align-center justify-center mud-width-full" style="height: 100vh;">
	<MudCard style="height: 500px; width:400px;" Elevation="4">
		<MudCardHeader>
			<CardHeaderContent>
				<MudText Typo="Typo.h6">Login</MudText>
			</CardHeaderContent>
			<CardHeaderActions>
				<MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Default" />
			</CardHeaderActions>
		</MudCardHeader>
		<MudCardMedia Image="assets/hris-1.jpeg" Height="200" />
		<MudForm @ref="form">
			<MudCardContent>
				<MudTextField @bind-Value="user.UserName"
									Immediate="true"
									Label="User Name" />
				<MudTextField @bind-Value="user.Password"
									Immediate="true"
									Label="Password" InputType="InputType.Password" />

			</MudCardContent>
			<MudCardActions>
			<MudButton Disabled="loading" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@(async () => await LoginAsync())">
				@if (loading) {
					<MudProgressCircular Size="Size.Small" Color="Color.Warning" Indeterminate=true />
					<MudText>...Loading</MudText>
				}
				else {
					<MudText>Login</MudText>
				}
			</MudButton>

			</MudCardActions>
		</MudForm>
	</MudCard>
</MudContainer>

@inject NavigationManager navigationManager
@inject IAuthenticationHttpClientService authenticationHttpClientService
@code {
	[CascadingParameter]
	public Task<AuthenticationState> authState { get; set; }

	UserLoginDTO user { get; set; } = new();
	MudTextField<string>? UserName;
	MudTextField<string>? Psw;
	MudForm? form;
	string? msg;
	bool loading = false;
	// TokenService tokenService { get; set; }

	protected override async Task OnInitializedAsync() {
		var user = (await authState).User;
		if (user.Identity!.IsAuthenticated) {
			navigationManager.NavigateTo("", true);
		}
		await base.OnInitializedAsync();
	}

	async Task LoginAsync() {
		// var result = await authenticationHttpClientService.LoginUser(user);
		// var result = Task.FromResult(authenticationHttpClientService.LoginUser(user));
		loading = true;
		var response = await authenticationHttpClientService.LoginUser(user);
		switch (response.StatusCode) {
			case HttpStatusCode.OK:
				var result = await response.Content.ReadFromJsonAsync<TokenDTO>();
				await tokenService.SetToken(result!);
				Snackbar.Add("Login succes!", Severity.Success);
				navigationManager.NavigateTo("", true);
				break;
			case HttpStatusCode.NotFound:
				msg = await response.Content.ReadAsStringAsync();
				Snackbar.Add(msg, Severity.Warning);
				break;
			case HttpStatusCode.Unauthorized:
				msg = await response.Content.ReadAsStringAsync();
				Snackbar.Add(msg, Severity.Warning);
			break;
		}
		loading = false;
		// Console.WriteLine($"response.StatusCode: {response.StatusCode}");
